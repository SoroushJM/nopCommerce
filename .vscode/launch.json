{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "nopCommerce: Select Launch Profile",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "nop: build storefront",
      "program": "${workspaceFolder}/src/Presentation/Nop.Web/bin/Debug/net10.0/Nop.Web.dll",
      "cwd": "${workspaceFolder}/src/Presentation/Nop.Web",
      "args": [],
      "launchSettingsFilePath": "${workspaceFolder}/src/Presentation/Nop.Web/Properties/launchSettings.json",
      "launchSettingsProfile": "${input:launchProfile}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ],
  "inputs": [
    {
      "id": "launchProfile",
      "type": "pickString",
      "description": "Which Launch Profile do you want to run?",
      "options": ["Madadrang", "Boutique", "Nop.Web"],
      "default": "Madadrang"
    }
  ]
}
