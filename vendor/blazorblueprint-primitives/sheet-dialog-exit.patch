diff --git a/src/BlazorBlueprint.Primitives/wwwroot/js/primitives/modal-exit.js b/src/BlazorBlueprint.Primitives/wwwroot/js/primitives/modal-exit.js
new file mode 100644
index 00000000..1fcc6fdd
--- /dev/null
+++ b/src/BlazorBlueprint.Primitives/wwwroot/js/primitives/modal-exit.js
@@ -0,0 +1,47 @@
+const active = new Map();
+const previousFocus = new Map();
+
+export function captureFocus(instanceId) {
+  previousFocus.set(instanceId, document.activeElement);
+}
+
+export function restoreFocus(instanceId, closingContent) {
+  const target = previousFocus.get(instanceId);
+  previousFocus.delete(instanceId);
+  const activeElement = document.activeElement;
+  const focusIsStillInClosingContent = closingContent?.contains(activeElement);
+  const targetIsUsable = target instanceof HTMLElement
+    && target.isConnected
+    && !target.inert
+    && !target.closest('[inert]');
+  if (targetIsUsable && (activeElement === document.body || focusIsStillInClosingContent)) {
+    target.focus({ preventScroll: true });
+  }
+}
+
+export function discardFocus(instanceId) { previousFocus.delete(instanceId); }
+
+export async function waitForExit(portalId, generation, dotNetRef) {
+  const token = Symbol();
+  active.set(portalId, token);
+  const done = () => {
+    if (active.get(portalId) !== token) return;
+    active.delete(portalId);
+    return dotNetRef.invokeMethodAsync('JsOnExitFinished', generation).catch(() => {});
+  };
+  if (globalThis.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return done();
+  await new Promise(requestAnimationFrame);
+  const root = document.querySelector(`[data-bb-modal-portal="${CSS.escape(portalId)}"]`);
+  if (!root || active.get(portalId) !== token) return done();
+  const finite = [...root.querySelectorAll('[data-bb-modal-exit-part][data-state="closed"]')].flatMap(element => element.getAnimations())
+    .filter(animation => {
+      const timing = animation.effect?.getTiming?.();
+      return animation.playState === 'running'
+        && Number.isFinite(timing?.iterations)
+        && timing.iterations !== Infinity;
+    });
+  if (finite.length) await Promise.allSettled(finite.map(a => a.finished));
+  if (active.get(portalId) === token) await done();
+}
+
+export function cancel(portalId) { active.delete(portalId); }
