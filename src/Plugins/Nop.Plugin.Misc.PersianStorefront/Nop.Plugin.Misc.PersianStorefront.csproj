<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <OutputPath Condition="'$(StorefrontPluginOutputRoot)' == ''">../../Presentation/Nop.Web/Plugins/Misc.PersianStorefront/</OutputPath>
    <OutputPath Condition="'$(StorefrontPluginOutputRoot)' != ''">$(StorefrontPluginOutputRoot)/Misc.PersianStorefront/</OutputPath>
    <OutDir>$([System.IO.Path]::GetFullPath('$(OutputPath)', '$(MSBuildProjectDirectory)'))/</OutDir>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Presentation/Nop.Web/Nop.Web.csproj" Private="false" />
    <ProjectReference Include="../../Storefront/Storefront.UI.Shared/Storefront.UI.Shared.csproj" />
    <ProjectReference Include="../../Storefront/Storefront.UI.Madadrang/Storefront.UI.Madadrang.csproj" Condition="'$(StorefrontBrand)' == 'Madadrang' Or '$(StorefrontBrand)' == 'All'" />
    <ProjectReference Include="../../Storefront/Storefront.UI.MishaShop/Storefront.UI.MishaShop.csproj" Condition="'$(StorefrontBrand)' == 'MishaShop' Or '$(StorefrontBrand)' == 'All'" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
    <PackageReference Include="BlazorBlueprint.Primitives" Version="$(StorefrontBlueprintPrimitivesVersion)" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(StorefrontBrand)' == 'MishaShop'">
    <Content Remove="Views/HomeHero.cshtml;Views/HomepageBanners.cshtml;Views/NativeHeader.cshtml;Views/NativeFooter.cshtml" />
    <RazorGenerate Remove="Views/HomeHero.cshtml;Views/HomepageBanners.cshtml;Views/NativeHeader.cshtml;Views/NativeFooter.cshtml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../Presentation/Nop.Web/App_Data/Localization/PersianPublic/fa-IR.public.xml"
                      LogicalName="Nop.Plugin.Misc.PersianStorefront.Localization.fa-IR.public.xml" />
    <Content Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Views/**/*.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content/admin-tailwind.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AdminTailwindSources Include="Views/Configure.cshtml;Views/MishaShopConfigure.cshtml;../../Storefront/Storefront.UI.Madadrang/Styles/admin.css;../../Storefront/Storefront.UI.Madadrang/package-lock.json" />
  </ItemGroup>
  <Target Name="RestoreAdminTailwind" BeforeTargets="BuildAdminTailwind">
    <MSBuild Projects="../../Storefront/Storefront.UI.Madadrang/Storefront.UI.Madadrang.csproj" Targets="RestoreStorefrontNodeModules" />
  </Target>
  <Target Name="BuildAdminTailwind" BeforeTargets="PrepareForBuild" DependsOnTargets="RestoreAdminTailwind"
          Inputs="@(AdminTailwindSources);$(MSBuildProjectFullPath)" Outputs="Content/admin-tailwind.css">
    <MakeDir Directories="Content" />
    <Exec WorkingDirectory="../../Storefront/Storefront.UI.Madadrang"
          Command="npm exec --offline -- tailwindcss -i ./Styles/admin.css -o ../../Plugins/Nop.Plugin.Misc.PersianStorefront/Content/admin-tailwind.css --minify" />
  </Target>
  <Import Project="Storefront.Client.Publish.targets" />
  <Target Name="BuildStorefrontClient" AfterTargets="Build" BeforeTargets="CopyStorefrontAssets"
          DependsOnTargets="PrepareStorefrontClientPublish"
          Inputs="$(_StorefrontClientPublishInputs)" Outputs="$(_StorefrontClientPublishOutput)">
    <!-- A separate process reevaluates the WASM SDK after restore and keeps host RID/solution properties out of the browser build. -->
    <PropertyGroup>
      <StorefrontClientCompilerArguments Condition="'$(UseSharedCompilation)' != ''">-p:UseSharedCompilation=&quot;$(UseSharedCompilation)&quot;</StorefrontClientCompilerArguments>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="dotnet publish &quot;../../Storefront/Storefront.Client/Storefront.Client.csproj&quot; --configuration &quot;$(Configuration)&quot; -p:StorefrontTheme=&quot;$(StorefrontBrand)&quot; $(StorefrontClientCompilerArguments) --output &quot;$(OutDir)Content/Client/&quot; --nologo" />
    <ItemGroup Condition="'$(StorefrontClientIncrementalPublish)' == 'true'">
      <_StorefrontClientPublishedFile Include="$(OutDir)Content/Client/**/*" />
    </ItemGroup>
    <WriteLinesToFile File="$(_StorefrontClientCache).outputs" Lines="@(_StorefrontClientPublishedFile->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Condition="'$(StorefrontClientIncrementalPublish)' == 'true'" />
    <Touch Files="$(_StorefrontClientPublishOutput)" AlwaysCreate="true" Condition="'$(StorefrontClientIncrementalPublish)' == 'true'" />
  </Target>
  <Target Name="CopyStorefrontAssets" AfterTargets="Build">
    <ItemGroup>
      <SharedAssets Include="../../Storefront/Storefront.UI.Shared/wwwroot/**/*" />
      <MadadrangAssets Include="../../Storefront/Storefront.UI.Madadrang/wwwroot/**/*" Condition="'$(StorefrontBrand)' == 'Madadrang' Or '$(StorefrontBrand)' == 'All'" />
      <MishaShopAssets Include="../../Storefront/Storefront.UI.MishaShop/wwwroot/**/*" Condition="'$(StorefrontBrand)' == 'MishaShop' Or '$(StorefrontBrand)' == 'All'" />
      <BBAssets Include="$(NuGetPackageRoot)blazorblueprint.components/4.1.0/staticwebassets/**/*" />
      <PrimitiveAssets Include="$(PkgBlazorBlueprint_Primitives)/staticwebassets/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(SharedAssets)" DestinationFiles="@(SharedAssets->'$(OutDir)Content/Storefront.UI.Shared/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MadadrangAssets)" DestinationFiles="@(MadadrangAssets->'$(OutDir)Content/Storefront.UI.Madadrang/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MishaShopAssets)" DestinationFiles="@(MishaShopAssets->'$(OutDir)Content/Storefront.UI.MishaShop/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BBAssets)" DestinationFiles="@(BBAssets->'$(OutDir)Content/BlazorBlueprint.Components/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PrimitiveAssets)" DestinationFiles="@(PrimitiveAssets->'$(OutDir)Content/BlazorBlueprint.Primitives/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishStorefrontAssets" AfterTargets="Publish">
    <ItemGroup><PublishedStorefrontAssets Include="$(OutDir)Content/**/*" /></ItemGroup>
    <Copy SourceFiles="@(PublishedStorefrontAssets)" DestinationFiles="@(PublishedStorefrontAssets->'$(PublishDir)/Content/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
