@model Storefront.UI.Shared.StoreNavigation
@using Storefront.UI.Shared
@using Storefront.UI.Shared.Components
@using Storefront.UI.Madadrang.Components
@using Nop.Web.Components
@using Nop.Web.Framework.Infrastructure
@using Nop.Core.Domain
@inject StoreInformationSettings storeSettings
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var profile = (StorefrontThemeProfile)ViewData["ThemeProfile"]!;
    var nativeMenu = ViewData["NativeMainMenu"] is true;
}
<div class="bg-secondary text-secondary-foreground text-center text-xs py-1 px-4">یک شروع رنگی برای روزهای تازه <span
    class="mx-2 text-primary">✦</span> لوازم‌تحریری که دوستشان داری</div>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderBefore })
    <header class="sf-header border-b-[.0625rem] border-border bg-background">
        <div class="wrap mx-auto max-w-[80rem] px-8 max-md:px-5 sf-header-utility flex flex-wrap items-center justify-between gap-2 py-1 text-xs">
            <div class="sf-native-header-links relative [&_li:has(.ico-account)]:hidden! [&_li:has(.ico-login)]:hidden! [&_li:has(.ico-logout)]:hidden! [&_#topcartlink]:hidden! [&_.header-links]:float-none [&_.header-links]:m-0 [&_.header-links]:p-0 [&_ul]:flex [&_ul]:flex-wrap [&_ul]:items-center [&_ul]:gap-3 [&_li]:m-0 [&_li]:p-0 [&_a]:text-xs [&_a]:text-muted-foreground [&_a]:normal-case">
                @await Component.InvokeAsync(typeof(HeaderLinksViewComponent))
                <div class="hidden">@await Component.InvokeAsync(typeof(FlyoutShoppingCartViewComponent))</div>
            </div>
            <div class="sf-native-selectors flex flex-wrap items-center justify-end gap-2 text-xs [&>div]:m-0! [&>div]:w-auto!">
            @await Component.InvokeAsync(typeof(TaxTypeSelectorViewComponent))
            @await Component.InvokeAsync(typeof(CurrencySelectorViewComponent))
            @await Component.InvokeAsync(typeof(LanguageSelectorViewComponent))
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderSelectors })
            </div>
        </div>
        <div class="wrap mx-auto max-w-[80rem] px-8 max-md:px-5 sf-header-main flex items-center justify-between gap-5 py-2 max-md:flex-wrap max-md:gap-2">
            @if (storeSettings.LogoPictureId > 0)
            {
                <div class="sf-brand sf-configured-logo flex shrink-0 items-center gap-2 text-xl font-bold tracking-[-0.0625rem] [&_img]:max-h-9 [&_img]:w-auto">@await Component.InvokeAsync(typeof(LogoViewComponent))</div>
            }
            else
            {
            <a href="@profile.HomeUrl" class="sf-brand flex! flex-nowrap! shrink-0! items-center! gap-2! text-xl! font-bold! tracking-[-0.0625rem]!" aria-label="مداد رنگی، صفحه اصلی">
                <span class="brand-mark grid! size-9! shrink-0! -rotate-[7deg]! place-items-center! rounded-lg! bg-primary! text-primary-foreground! [&_svg]:size-[1.4375rem]! [&_svg]:block! [&_svg]:m-0!">
                    <component type="typeof(SfIcon)" render-mode="Static" param-Size="@(1.4375m)" />
                </span>
                <span class="brand-word block! whitespace-nowrap! leading-6!">مداد <span class="text-primary">رنگی</span><small
                    class="block! text-xs! font-normal! tracking-normal! text-muted-foreground! mt-0.5! leading-5!">دنیای کوچکِ ایده‌های
                    بزرگ</small></span>
                </a>
            }
                <div class="sf-native-search w-full max-w-[29.375rem] max-md:order-3 max-md:basis-full max-md:max-w-none [&_.search-box]:float-none [&_.search-box]:m-0 [&_.search-box]:w-full [&_form]:flex [&_form]:w-full [&_form]:gap-1.5 [&_input[type=text]]:h-9 [&_input[type=text]]:w-full [&_input[type=text]]:min-w-0 [&_input[type=text]]:rounded-[var(--radius)] [&_input[type=text]]:border-[.0625rem] [&_input[type=text]]:border-border [&_input[type=text]]:bg-muted [&_input[type=text]]:px-3 [&_input[type=text]]:py-1.5 [&_input[type=text]]:font-[inherit] [&_.search-box-button]:h-9 [&_.search-box-button]:min-w-[4.5rem] [&_.search-box-button]:rounded-[var(--radius)] [&_.search-box-button]:bg-primary [&_.search-box-button]:font-[inherit] [&_.search-box-button]:text-primary-foreground">@await Component.InvokeAsync(typeof(SearchBoxViewComponent))</div>
                <div class="flex items-center gap-2">
                    @if (!nativeMenu)
                    {
                    <div class="md:hidden">
                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new
                        {
                            widgetZone =
                        PublicWidgetZones.MobHeaderMenuBefore
                        })
                        <component type="typeof(StorefrontMainMenu)" render-mode="WebAssemblyPrerendered"
                                   param-Menu="Model.Main" param-Mobile="true" />
                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new
                        {
                            widgetZone =
                        PublicWidgetZones.MobHeaderMenuAfter
                        })
                    </div>
                    }
                    <component type="typeof(NativeHeader)" render-mode="WebAssemblyPrerendered" param-Initial="Model"
                               param-OpenLoginOnLoad="@(Context.Items["Madadrang.OpenLogin"] is true)"
                               param-AccountDropdown="true"
                               param-Theme="@profile" />
                </div>
            </div>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderMiddle })
            <div class="wrap mx-auto max-w-[80rem] px-8 max-md:px-5 border-t-[.0625rem] border-border [&_.menu\_\_item-link]:font-[inherit] [&_.menu\_\_item-link]:text-foreground @(nativeMenu ? "sf-native-menu py-1 [&_.menu-container]:m-0 [&_.menu-container]:max-w-none" : "max-md:hidden")">
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new
                {
                    widgetZone = PublicWidgetZones.HeaderMenuBefore
                })
                @if (nativeMenu)
                {
                    <div class="md:hidden">
                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.MobHeaderMenuBefore })
                    </div>
                    @await Component.InvokeAsync(typeof(MainMenuViewComponent))
                    <div class="md:hidden">
                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.MobHeaderMenuAfter })
                    </div>
                }
                else
                {
                    <component type="typeof(StorefrontMainMenu)" render-mode="WebAssemblyPrerendered" param-Menu="Model.Main" />
                }
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new
                {
                    widgetZone = PublicWidgetZones.HeaderMenuAfter
                })
            </div>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderAfter })
        </header>
<component type="typeof(NativeCatalogPurchase)" render-mode="WebAssemblyPrerendered" />
<script asp-location="Footer">
    window.MadadrangPurchase = {
        pending: null,
        open: function (url) {
            this.pending = url;
            window.dispatchEvent(new CustomEvent('storefront:purchase', { detail: { url: url } }));
        }
    };
    $(function () {
        // Keep the native failure alert, adding only safe transport metadata for the owner's next attempt.
        // Never expose the response body, exception details, request URL or antiforgery token.
        AjaxCart.ajaxFailure = function (xhr, textStatus) {
            var status = Number.isInteger(xhr && xhr.status) ? xhr.status : 0;
            var kind = ['parsererror', 'timeout', 'abort'].includes(textStatus) ? textStatus : 'error';
            var detail = kind === 'parsererror' ? 'پاسخ سرور قابل خواندن نبود'
                : kind === 'timeout' ? 'زمان انتظار درخواست تمام شد'
                : kind === 'abort' ? 'درخواست لغو شد'
                : status === 0 ? 'ارتباط با سرور برقرار نشد' : 'درخواست از طرف سرور پذیرفته نشد';
            var message = AjaxCart.localized_data && AjaxCart.localized_data.AjaxCartFailure;
            console.warn('Madadrang native cart request failed', { status: status, kind: kind });
            alert((message || 'افزودن محصول انجام نشد.') + '\n' + detail + ' (HTTP ' + status + ')');
        };
    });
</script>
