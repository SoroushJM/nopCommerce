@model Storefront.UI.StoreNavigation
@using Storefront.UI
@using Storefront.UI.Components
@using Nop.Web.Components
@using Nop.Web.Framework.Infrastructure
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<div class="bg-secondary text-secondary-foreground text-center text-xs py-2.5 px-4">یک شروع رنگی برای روزهای تازه <span
    class="mx-2 text-primary">✦</span> لوازم‌تحریری که دوستشان داری</div>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderBefore })
    <header class="sf-header">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderSelectors })
        <div class="wrap flex items-center justify-between gap-7 py-5 max-md:py-4">
            <a href="/" class="sf-brand shrink-0" aria-label="مدادرنگ، صفحه اصلی">
                <span class="brand-mark">
                    <component type="typeof(SfIcon)" render-mode="Static" param-Size="23" />
                </span>
                <span class="brand-word">مداد<span class="text-primary">رنگ</span><small
                    class="block text-xs font-normal tracking-normal text-muted-foreground mt-0.5">دنیای کوچکِ ایده‌های
                    بزرگ</small></span>
                </a>
                <component type="typeof(StorefrontSearch)" render-mode="Static" />
                <div class="flex items-center gap-2">
                    <div class="md:hidden">
                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new
                        {
                            widgetZone =
                        PublicWidgetZones.MobHeaderMenuBefore
                        })
                        <component type="typeof(StorefrontMainMenu)" render-mode="WebAssemblyPrerendered"
                                   param-Menu="Model.Main" param-Mobile="true" />
                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new
                        {
                            widgetZone =
                        PublicWidgetZones.MobHeaderMenuAfter
                        })
                    </div>
                    @await Component.InvokeAsync(typeof(WidgetViewComponent), new
                    {
                        widgetZone =
                    PublicWidgetZones.HeaderLinksBefore,
                        additionalData = ViewData["HeaderLinksModel"]
                    })
                    <component type="typeof(NativeHeader)" render-mode="WebAssemblyPrerendered" param-Initial="Model"
                               param-OpenLoginOnLoad="@(Context.Items["Madadrang.OpenLogin"] is true)" />
                    @await Component.InvokeAsync(typeof(WidgetViewComponent), new
                    {
                        widgetZone =
                    PublicWidgetZones.HeaderLinksAfter,
                        additionalData = ViewData["HeaderLinksModel"]
                    })
                </div>
            </div>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderMiddle })
            <div class="wrap border-t border-border max-md:hidden">
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new
                {
                    widgetZone = PublicWidgetZones.HeaderMenuBefore
                })
                <component type="typeof(StorefrontMainMenu)" render-mode="WebAssemblyPrerendered" param-Menu="Model.Main" />
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new
                {
                    widgetZone = PublicWidgetZones.HeaderMenuAfter
                })
            </div>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderAfter })
        </header>
