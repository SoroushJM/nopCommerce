@model Nop.Web.Models.Catalog.CategoryModel
@using Nop.Core.Domain.Catalog
@using Storefront.UI.Shared
@inject Nop.Web.Framework.Mvc.Routing.INopUrlHelper NopUrl
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var styles = new[] { (Tone: "notebook", Icon: "notebook"), (Tone: "stationery", Icon: "pencil"),
        (Tone: "school", Icon: "bag"), (Tone: "art", Icon: "leaf") };
    var style = styles[(int)ViewData["Style"]!];
}
<a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = Model.SeName }))" class="category-tile grid min-w-0 grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-x-[.625rem] gap-y-[.875rem] rounded-[.875rem] border-[.0625rem] border-solid border-border bg-card p-[1rem] text-start transition-colors hover:bg-surface focus-visible:outline-[.125rem] focus-visible:outline-offset-[.1875rem] focus-visible:outline-ring max-[25rem]:grid-cols-[2.25rem_minmax(0,1fr)] max-[25rem]:gap-x-[.5rem] max-[25rem]:p-[.75rem] motion-reduce:transition-none"
   data-categoryid="@Model.Id">
    <span class="category-icon grid size-[2.5rem] place-items-center rounded-[.625rem] max-[25rem]:size-[2.25rem] data-[tone=notebook]:bg-secondary data-[tone=notebook]:text-secondary-foreground data-[tone=stationery]:bg-stationery data-[tone=stationery]:text-stationery-foreground data-[tone=school]:bg-school data-[tone=school]:text-school-foreground data-[tone=art]:bg-art data-[tone=art]:text-art-foreground" data-tone="@style.Tone">
        <component type="typeof(SfIcon)" render-mode="Static" param-Name="style.Icon" param-Size="@(1.25m)" />
    </span>
    <strong class="min-w-0 text-[.875rem] font-semibold leading-[1.75] text-foreground max-[25rem]:text-[.8125rem]">@Model.Name</strong>
    <span class="col-span-full flex items-center justify-between gap-[.5rem] text-[.75rem] leading-[1.5] text-muted-foreground">
        <span>کشف کن</span>
        <component type="typeof(SfIcon)" render-mode="Static" param-Name='@("arrow")' param-Size="@(1m)" />
    </span>
</a>
