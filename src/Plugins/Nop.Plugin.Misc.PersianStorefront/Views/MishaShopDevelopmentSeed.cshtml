@model Nop.Plugin.Misc.PersianStorefront.Controllers.MishaShopDevelopmentSeedModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout = "_ConfigurePlugin"; }

<div class="card card-default">
    <div class="card-header"><h3>داده‌های نمونهٔ توسعهٔ میشا شاپ</h3></div>
    <div class="card-body">
        <p>این عملیات ۱۲ محصول نمونهٔ لباس و اکسسوری، ۵ دسته، یک برند نمونه و ۶۶ ترکیب رنگ/سایز را با تصویرسازی محلی آماده می‌کند. دو ترکیب ناموجودند تا وضعیت اتمام موجودی نیز قابل مشاهده باشد.</p>
        <p>قیمت‌ها به تومان‌اند؛ پیش از اجرا، در <strong>پیکربندی ← ارزها</strong>، تومان با کد <strong>IRT</strong> را ارز اصلی فروشگاه تعیین کنید. تنظیم ارز و نرخ تبدیل، checkout، منوها و تصویر صفحهٔ اصلی با این عملیات تغییر نمی‌کنند.</p>
        <p>فقط از پایگاه‌دادهٔ توسعهٔ مستقل میشا شاپ استفاده کنید. عوض‌کردن تم در راه‌انداز محلی، دیتابیس را عوض نمی‌کند؛ وجود محصولات <code>MRG-*</code> باعث رد عملیات می‌شود.</p>
        <p>@Model.Availability.Message</p>
        @if (Model.Availability.CanSeed)
        {
            <p>تعداد SKUهای نمونهٔ موجود: @Model.Availability.ExistingProducts. این محصولات، حتی اگر ویرایش شده باشند، بازنویسی نمی‌شوند.</p>
            <form id="mishashop-development-seed" asp-controller="MishaShopDevelopmentSeed" asp-action="Configure" asp-area="Admin" method="post">
                <button type="submit" class="btn btn-primary">ساخت داده‌های نمونهٔ توسعهٔ میشا شاپ</button>
            </form>
        }
        @if (Model.Result is { } result)
        {
            <div role="status" class="mt-3">
                <p>محصول تازه: @result.AddedProducts؛ محصول موجود و حفظ‌شده: @result.SkippedProducts؛ دستهٔ تازه: @result.AddedCategories؛ برند تازه: @result.AddedManufacturers؛ ترکیب تازه: @result.AddedCombinations.</p>
                <ul>@foreach (var message in result.Messages) { <li>@message</li> }</ul>
            </div>
        }
        <p class="mt-3">اگر اجرای قبلی نیمه‌کاره مانده باشد، محصول کامل‌نشده منتشر نمی‌شود و SKU آن در اجرای بعد کنار گذاشته می‌شود. آن را از فهرست محصولات ادمین بررسی کنید؛ این ابزار دادهٔ موجود را تعمیر یا حذف نمی‌کند.</p>
    </div>
</div>
