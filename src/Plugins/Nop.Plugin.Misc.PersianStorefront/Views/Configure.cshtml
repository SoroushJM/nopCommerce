@model bool
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_ConfigurePlugin";
}
<div class="card card-default">
    <div class="card-body">
        <h3>داده‌های نمونهٔ قالب مدادرنگ</h3>
        @if (Model)
        {
            <p>این عملیات فقط نمایش داده‌های نمونهٔ محلی MRG-1 تا MRG-8 را آماده می‌کند: آدرس استاندارد، دسته‌های صفحهٔ
                اصلی، محصولات منتخب و تازه، و منوهای نمونهٔ قابل ویرایش.</p>
                <p>قیمت، موجودی، ویژگی‌ها، تصاویر و تنظیمات ارز یا خرید تغییر نمی‌کنند. منوها و متن خوشامدگویی انگلیسی پیش‌فرضِ دست‌نخورده غیرفعال می‌شوند؛ محتوای ویرایش‌شده حفظ می‌شود.</p>
                    <form id="madadrang-fixture-repair" asp-controller="PersianStorefrontMaintenance" asp-action="Configure" asp-area="Admin" method="post">
                        <button type="submit" class="btn btn-primary">آماده‌سازی نمایش نمونه‌های محلی</button>
                    </form>
                }
        else
                {
                    <p>آماده‌سازی نمونه‌ها فقط در محیط توسعه، با درخواست محلی و دیتابیس آزمایشی محلی در دسترس است.</p>
                }
                @if (ViewData["Report"] is IEnumerable<string> report)
                {
                    <ul>
                        @foreach (var line in report)
                        {
                            <li>@line</li>
                        }
                    </ul>
                }
            </div>
        </div>
