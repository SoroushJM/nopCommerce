@inject Nop.Web.Framework.UI.INopHtmlHelper NopHtml
@model bool
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_ConfigurePlugin"; NopHtml.AppendCssFileParts("~/Plugins/Misc.PersianStorefront/Content/admin-tailwind.css");
}
<div class="storefront-admin adm:rounded-lg adm:border-[.0625rem] adm:border-solid adm:border-slate-200 adm:bg-white adm:text-slate-900">
    <div class="adm:p-6 adm:[&_h3]:mb-4 adm:[&_h3]:text-xl adm:[&_h3]:font-semibold adm:[&_p]:my-3 adm:[&_p]:leading-7 adm:[&_ul]:my-4 adm:[&_ul]:list-disc adm:[&_ul]:ps-5">
        <h3>داده‌های نمونهٔ قالب مداد رنگی</h3>
        @if (Model)
        {
            <p>این عملیات فقط نمایش داده‌های نمونهٔ محلی MRG-1 تا MRG-8 را آماده می‌کند: آدرس استاندارد، دسته‌های صفحهٔ
                اصلی، محصولات منتخب و تازه، و منوهای نمونهٔ قابل ویرایش.</p>
                <p>فیلتر قیمت دسته‌های نمونه و مشخصات رنگِ قابل فیلتر از روی رنگ‌های واقعی نمونه‌ها، یک بار آماده می‌شوند. بازهٔ ثابت پیش‌فرض جست‌وجو در صورت دست‌نخورده بودن، برای این فروشگاه به بازهٔ خودکار محصولات تبدیل می‌شود؛ ترجمه‌های فارسیِ مفقود کاتالوگ نیز اضافه می‌شوند. قیمت، موجودی، ویژگی‌های انتخاب خرید، تصاویر و تنظیمات ارز یا خرید تغییر نمی‌کنند. منوها و متن خوشامدگویی انگلیسی پیش‌فرضِ دست‌نخورده غیرفعال می‌شوند؛ محتوای ویرایش‌شده حفظ می‌شود.</p>
                    <form id="madadrang-fixture-repair" asp-controller="PersianStorefrontMaintenance" asp-action="Configure" asp-area="Admin" method="post">
                        <button type="submit" class="adm:inline-flex adm:min-h-11 adm:items-center adm:justify-center adm:rounded-md adm:border-[0rem] adm:bg-sky-700 adm:px-5 adm:py-2 adm:text-sm adm:font-medium adm:text-white adm:hover:bg-sky-800 adm:focus-visible:outline-solid adm:focus-visible:outline-[0.125rem] adm:focus-visible:outline-offset-[0.125rem] adm:focus-visible:outline-sky-700">آماده‌سازی نمایش نمونه‌های محلی</button>
                    </form>
                }
        else
                {
                    <p>آماده‌سازی نمونه‌ها فقط در محیط توسعه، با درخواست محلی و دیتابیس آزمایشی محلی در دسترس است.</p>
                }
                @if (ViewData["Report"] is IEnumerable<string> report)
                {
                    <ul>
                        @foreach (var line in report)
                        {
                            <li>@line</li>
                        }
                    </ul>
                }
            </div>
        </div>
