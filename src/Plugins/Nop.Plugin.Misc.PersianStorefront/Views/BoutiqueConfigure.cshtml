@model Nop.Plugin.Misc.PersianStorefront.Controllers.BoutiqueThemeConfigurationModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Nop.Web.Framework
@{ Layout = "_ConfigurePlugin"; }
<form asp-controller="StorefrontThemeSettings" asp-action="Configure" asp-area="Admin" method="post">
    <div class="card card-default">
        <div class="card-body">
            <h3>ظاهر فروشگاه لباس</h3>
            <p>نام برند از تنظیمات نام فروشگاه خوانده می‌شود. تصویر واقعی فروشگاه و متن صفحهٔ اصلی را اینجا انتخاب کنید.</p>
            <div asp-validation-summary="All"></div>
            <div class="form-group row">
                <div class="col-md-3"><label for="HeroPictureId">تصویر صفحهٔ اصلی</label></div>
                <div class="col-md-9"><nop-editor asp-for="HeroPictureId" /></div>
            </div>
            <div class="form-group row">
                <div class="col-md-3"><label asp-for="HeroHeading">عنوان صفحهٔ اصلی</label></div>
                <div class="col-md-9"><input asp-for="HeroHeading" class="form-control" /><span asp-validation-for="HeroHeading"></span></div>
            </div>
            <div class="form-group row">
                <div class="col-md-3"><label asp-for="HeroDescription">توضیح کوتاه</label></div>
                <div class="col-md-9"><textarea asp-for="HeroDescription" class="form-control"></textarea><span asp-validation-for="HeroDescription"></span></div>
            </div>
            <button type="submit" class="btn btn-primary">ذخیره</button>
        </div>
    </div>
</form>
