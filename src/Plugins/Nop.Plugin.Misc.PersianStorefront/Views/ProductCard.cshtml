@model Nop.Web.Models.Catalog.ProductOverviewModel
@using Nop.Core.Http
@using Nop.Web.Extensions
@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Tax
@using Nop.Web.Components
@using Nop.Web.Framework.Infrastructure
@using Nop.Web.Framework.Mvc.Routing
@using Storefront.UI.Shared
@inherits Nop.Web.Framework.Mvc.Razor.NopRazorPage<TModel>
@inject Nop.Web.Framework.Mvc.Routing.INopUrlHelper NopUrl
@inject IWorkContext workContext
@inject CatalogSettings catalogSettings
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var url = await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName });
    var picture = Model.PictureModels.FirstOrDefault();
    var inStock = (bool)ViewData["InStock"]!;
    var label = !inStock ? "ناموجود" : Model.ProductPrice.DisableBuyButton ? "خرید غیرفعال" : Model.MarkAsNew ? "تازه رسیده" : !string.IsNullOrEmpty(Model.ProductPrice.OldPrice) ? "پیشنهاد رنگی" : "";
    var addtocartlink = Model.ProductPrice.ForceRedirectionAfterAddingToCart
        ? Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_CART_CATALOG, new { productId = Model.Id, shoppingCartTypeId = (int)ShoppingCartType.ShoppingCart, quantity = 1, forceredirection = Model.ProductPrice.ForceRedirectionAfterAddingToCart })
        : Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_CART_CATALOG, new { productId = Model.Id, shoppingCartTypeId = (int)ShoppingCartType.ShoppingCart, quantity = 1 });
    var addtowishlistlink = Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_CART_CATALOG, new { productId = Model.Id, shoppingCartTypeId = (int)ShoppingCartType.Wishlist, quantity = 1 });
    var addtocomparelink = Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_COMPARE, new { productId = Model.Id });
    var cardIconAttributes = new Dictionary<string, object>
    {
        ["aria-hidden"] = "true",
        ["data-icon"] = "inline-start"
    };
}
<article class="product-card group flex h-full flex-col overflow-hidden rounded-lg border-[.0625rem] border-border bg-background transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:shadow-(--shadow-hover) [.sf-catalog-list_&]:flex-row max-md:[.sf-catalog-list_&]:flex-col motion-reduce:transform-none motion-reduce:translate-none motion-reduce:transition-none" data-productid="@Model.Id" data-product-stock="@inStock.ToString().ToLowerInvariant()">
        <div class="product-photo relative h-56 shrink-0 overflow-hidden bg-surface max-md:h-[11.875rem] [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_img]:transition-transform [&_img]:duration-[400ms] group-hover:[&_img]:scale-[1.04] motion-reduce:[&_img]:transform-none motion-reduce:[&_img]:scale-100 motion-reduce:[&_img]:transition-none">
            @if (Model.PictureModels.Count > 1)
            {
                <div class="swiper h-full" id="swiper-@Model.Id" dir="@Html.GetUIDirection(!await Html.ShouldUseRtlThemeAsync())">
                    <div class="swiper-wrapper">
                        @foreach (var item in Model.PictureModels)
                        {
                            <a class="swiper-slide" href="@url" title="@item.Title">
                                <img src="@item.ImageUrl" alt="@item.AlternateText" title="@item.Title" loading="lazy" />
                            </a>
                        }
                    </div>
                    <div class="swiper-pagination"></div>
                </div>
                <script asp-location="Footer">
                    new Swiper('#swiper-@(Model.Id)', {
                        pagination: { clickable: true, el: '.swiper-pagination' }
                    });
                </script>
            }
            else
            {
                <a href="@url" aria-label="@Model.Name" title="@picture?.Title"><img src="@picture?.ImageUrl" alt="@picture?.AlternateText" title="@picture?.Title" loading="lazy" /></a>
            }
            @if (label.Length > 0)
            {
                <span class="tag absolute right-3 top-3 inline-flex items-center rounded-[.25rem] bg-background px-[0.5625rem] py-[0.3125rem] text-xs font-semibold text-foreground">@label</span>
            }
        </div>
    <a href="@url" aria-label="@Model.Name">
        <div class="p-4 pb-2">
            <p class="text-xs text-muted-foreground mb-2">@ViewData["Caption"]</p>
            <h3 class="text-sm font-bold leading-6">@Model.Name</h3>
            <div class="flex gap-1.5 mt-2" aria-label="رنگ‌های محصول">
                @foreach (var color in (List<string>)ViewData["Colors"]!)
                {
                    <span style="--swatch-color:@color" class="bg-(--swatch-color) size-2.5 rounded-[9999rem] border-[.0625rem] border-background ring-[0.0625rem] ring-border"></span>
                }
            </div>
        </div>
    </a>
    <div class="px-4 pb-3">
        @if (catalogSettings.ShowSkuOnCatalogPages && !string.IsNullOrEmpty(Model.Sku))
        {
            <div class="sku text-xs text-muted-foreground mb-2">@Model.Sku</div>
        }
        @if (Model.ReviewOverviewModel.AllowCustomerReviews)
        {
            var ratingPercent = Model.ReviewOverviewModel.TotalReviews == 0 ? 0
                : ((Model.ReviewOverviewModel.RatingSum * 100) / Model.ReviewOverviewModel.TotalReviews) / 5;
            <div class="product-rating-box inline-block mb-2" title="@string.Format(T("Reviews.TotalReviews").Text, Model.ReviewOverviewModel.TotalReviews)">
                <div class="rating h-3.5 w-[5.9375rem] bg-(image:--rating-image) bg-repeat-x" style="--rating-image:url('@Url.Content("~/Themes/DefaultClean/Content/images/rating1.png")')">
                    <div class="h-3.5 w-(--rating-percent) bg-(image:--rating-image) bg-repeat-x" style="--rating-percent:@(ratingPercent)%;--rating-image:url('@Url.Content("~/Themes/DefaultClean/Content/images/rating2.png")')"></div>
                </div>
            </div>
        }
        <div class="description text-xs text-muted-foreground leading-6" hidden="@(!catalogSettings.ShowShortDescriptionOnCatalogPages)" @(catalogSettings.ShowShortDescriptionOnCatalogPages ? "" : "data-short-description=none")>@Html.Raw(Model.ShortDescription)</div>
    </div>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoBefore, additionalData = Model })
    <div class="mt-auto flex items-end justify-between gap-2 px-4 pb-4 [.sf-catalog-list_&]:mt-0">
        <div>
            @if (!string.IsNullOrEmpty(Model.ProductPrice.OldPrice))
            {
                <del class="text-xs text-muted-foreground block mb-1 price">@Model.ProductPrice.OldPrice</del>
            }
            <p class="text-sm font-bold price">@Model.ProductPrice.Price</p>
            @if (Model.ProductPrice.DisplayTaxShippingInfo)
            {
                var inclTax = await workContext.GetTaxDisplayTypeAsync() == TaxDisplayType.IncludingTax;
                <small>@T(inclTax ? "Products.Price.TaxShipping.InclTax" : "Products.Price.TaxShipping.ExclTax", await NopUrl.RouteTopicUrlAsync("shippinginfo"))</small>
            }
            @if (!string.IsNullOrEmpty(Model.ProductPrice.BasePricePAngV))
            {
                <small class="block">@Model.ProductPrice.BasePricePAngV</small>
            }
        </div>
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoMiddle, additionalData = Model })
        <a href="@url" aria-label="مشاهدهٔ @Model.Name" class="inline-flex min-h-10 shrink-0 items-center gap-1 rounded-md px-2 text-xs text-primary transition-colors hover:bg-secondary focus-visible:outline-[.125rem] focus-visible:outline-offset-[.125rem] focus-visible:outline-ring motion-reduce:transition-none">
            <span>مشاهده</span>
            <component type="typeof(SfIcon)" render-mode="Static" param-Name='@("arrow")' param-Size="@(.875m)" />
        </a>
    </div>
    <div class="buttons grid shrink-0 gap-2 px-4 pb-4 text-xs">
        @if (!Model.ProductPrice.DisableBuyButton)
        {
            var addToCartText = T("ShoppingCart.AddToCart").Text;
            if (Model.ProductPrice.IsRental)
                addToCartText = T("ShoppingCart.Rent").Text;
            if (Model.ProductPrice.AvailableForPreOrder)
                addToCartText = T("ShoppingCart.PreOrder").Text;
            <button type="button" class="product-box-add-to-cart-button inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-lg bg-primary px-3 py-2.5 font-semibold text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-[.125rem] focus-visible:outline-offset-[.125rem] focus-visible:outline-ring motion-reduce:transition-none" onclick="AjaxCart.addproducttocart_catalog('@addtocartlink');return false;">
                <component type="typeof(SfIcon)" render-mode="Static" param-Name='@("bag")' param-Size="@(1m)" />
                <span>@addToCartText</span>
            </button>
        }
        @if (!Model.ProductPrice.DisableAddToCompareListButton || !Model.ProductPrice.DisableWishlistButton)
        {
            <div class="flex! min-w-0 flex-nowrap! items-center! gap-2">
                @if (!Model.ProductPrice.DisableWishlistButton)
                {
                    @await Html.PartialAsync("_MoveToWishlistModal", Model.ProductToWishlist)
                    <button type="button" class="add-to-wishlist-button inline-flex! h-[2.5rem]! min-h-[2.5rem]! max-h-[2.5rem]! min-w-0! flex-1! basis-0! items-center! justify-center! gap-1.5! overflow-hidden! rounded-lg border-[.0625rem] border-border bg-background px-2 py-2 text-xs! text-muted-foreground transition-colors hover:border-primary/30 hover:bg-secondary hover:text-primary focus-visible:outline-[.125rem] focus-visible:outline-offset-[.125rem] focus-visible:outline-ring motion-reduce:transition-none [&>svg]:size-[1rem]! [&>svg]:min-w-[1rem]! [&>svg]:max-w-[1rem]! [&>svg]:min-h-[1rem]! [&>svg]:max-h-[1rem]! [&>svg]:shrink-0!" title="@T("ShoppingCart.AddToWishlist")" aria-label="@T("ShoppingCart.AddToWishlist")" onclick="AjaxCart.addproducttocart_catalog('@addtowishlistlink');return false;">
                        <component type="typeof(BlazorBlueprint.Icons.Lucide.Components.LucideIcon)" render-mode="Static" param-Name='@("heart")' param-StrokeWidth="@(1.7)" param-AdditionalAttributes="@cardIconAttributes" />
                        <span class="truncate">علاقه‌مندی</span>
                    </button>
                }
                @if (!Model.ProductPrice.DisableAddToCompareListButton)
                {
                    <button type="button" class="add-to-compare-list-button inline-flex! h-[2.5rem]! min-h-[2.5rem]! max-h-[2.5rem]! min-w-0! flex-1! basis-0! items-center! justify-center! gap-1.5! overflow-hidden! rounded-lg border-[.0625rem] border-border bg-background px-2 py-2 text-xs! text-muted-foreground transition-colors hover:border-primary/30 hover:bg-secondary hover:text-primary focus-visible:outline-[.125rem] focus-visible:outline-offset-[.125rem] focus-visible:outline-ring motion-reduce:transition-none [&>svg]:size-[1rem]! [&>svg]:min-w-[1rem]! [&>svg]:max-w-[1rem]! [&>svg]:min-h-[1rem]! [&>svg]:max-h-[1rem]! [&>svg]:shrink-0!" title="@T("ShoppingCart.AddToCompareList")" aria-label="@T("ShoppingCart.AddToCompareList")" onclick="AjaxCart.addproducttocomparelist('@addtocomparelink');return false;">
                        <component type="typeof(BlazorBlueprint.Icons.Lucide.Components.LucideIcon)" render-mode="Static" param-Name='@("columns-2")' param-StrokeWidth="@(1.7)" param-AdditionalAttributes="@cardIconAttributes" />
                        <span class="truncate">مقایسه</span>
                    </button>
                }
            </div>
        }
    </div>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoAfter, additionalData = Model })
</article>
