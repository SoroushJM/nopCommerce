@model IList<CategoryModel>
@using Nop.Core.Domain.Catalog
@if (Model.Count > 0)
{
    <section class="mishashop-categories [margin:2.25rem_0_3rem]! text-center! max-[40rem]:[margin:1.75rem_0_2.25rem]!" aria-label="دسته‌بندی‌ها">
        <h2 class="text-[1.25rem]! font-medium! [margin:0_0_1.5rem]! max-[40rem]:text-[1.125rem]!">دسته‌بندی‌ها</h2>
        <div class="mishashop-category-pills flex! justify-center! flex-wrap! gap-3! [&_>_a:hover]:border-ring! [&_>_a:hover]:bg-[#e7d5c5]! max-[40rem]:gap-2!">
            @foreach (var item in Model)
            {
                <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = item.SeName }))" class="inline-flex! py-[0.625rem]! px-[1.625rem]! bg-secondary! border-[0.0625rem]! border-solid! border-transparent! rounded-[9999rem]! text-[0.8125rem]! hover:border-ring! hover:bg-[#e7d5c5]! max-[40rem]:py-2! max-[40rem]:px-[1.125rem]! max-[40rem]:text-[0.6875rem]!">@item.Name</a>
            }
        </div>
    </section>
}
