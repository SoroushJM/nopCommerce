@model IList<CategoryModel>
@using Nop.Core.Domain.Catalog
@if (Model.Count > 0)
{
    <section class="boutique-categories" aria-label="دسته‌بندی‌ها">
        <h2>دسته‌بندی‌ها</h2>
        <div class="boutique-category-pills">
            @foreach (var item in Model)
            {
                <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = item.SeName }))">@item.Name</a>
            }
        </div>
    </section>
}
