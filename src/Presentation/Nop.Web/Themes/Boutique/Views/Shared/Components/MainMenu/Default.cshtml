@model MenuModel

@using Nop.Core.Domain.Menus;

<script src="~/js/public.menu.js" asp-location="Footer"></script>
<script asp-location="Footer">
    mainMenu.init('.menu-container .menu__toggle, .menu-container .menu__item-toggle', 'menu-dropdown--active');
</script>


<nav class="menu-container menu-dropdown static! m-0! p-0! w-full! block!
            max-[62.5rem]:[&_[role=menuitem]]:block! max-[62.5rem]:[&_[role=menuitem]]:w-full! max-[62.5rem]:[&_[role=menuitem]]:m-0! max-[62.5rem]:[&_[role=menuitem]]:p-0! max-[62.5rem]:[&_[role=menuitem]]:border-[0rem]!
            max-[62.5rem]:[&_a[role=button]]:flex! max-[62.5rem]:[&_a[role=button]]:items-center! max-[62.5rem]:[&_a[role=button]]:min-h-[2.75rem]! max-[62.5rem]:[&_a[role=button]]:px-[0.75rem]! max-[62.5rem]:[&_a[role=button]]:py-[0.5rem]! max-[62.5rem]:[&_a[role=button]]:rounded-[0.5rem]! max-[62.5rem]:[&_a[role=button]]:text-start! max-[62.5rem]:[&_a[role=button]]:leading-[1.6]! max-[62.5rem]:[&_a[role=button]:hover]:bg-muted!
            max-[62.5rem]:[&_[aria-haspopup=menu]:not(a)]:p-0!">
    <component type="typeof(BoutiqueMenuTrigger)" render-mode="Static" param-TriggerId='@($"menu-{Model.Id}")' param-ContentId='@($"boutique-menu-content-{Model.Id}")' param-Name="Model.Name" />
    <div id="boutique-menu-content-@Model.Id" role="menu" class="menu @Model.CssClass
            max-[62.5rem]:absolute! max-[62.5rem]:[inset-block-start:calc(100%_+_0.25rem)]! max-[62.5rem]:inset-x-0! max-[62.5rem]:w-full! max-[62.5rem]:m-0! max-[62.5rem]:p-2! max-[62.5rem]:bg-card! max-[62.5rem]:border-[0.0625rem]! max-[62.5rem]:border-solid! max-[62.5rem]:border-border! max-[62.5rem]:rounded-[0.875rem]! max-[62.5rem]:shadow-[0_0.875rem_1.875rem_#493c3315]! max-[62.5rem]:max-h-0! max-[62.5rem]:opacity-0! max-[62.5rem]:invisible! max-[62.5rem]:overflow-hidden! max-[62.5rem]:pointer-events-none! max-[62.5rem]:[transition:opacity_.16s_ease,visibility_0s_linear_.16s]! max-[62.5rem]:z-[34]!
            max-[62.5rem]:[.menu-dropdown--active>&]:max-h-[70vh]! max-[62.5rem]:[.menu-dropdown--active>&]:opacity-100! max-[62.5rem]:[.menu-dropdown--active>&]:visible! max-[62.5rem]:[.menu-dropdown--active>&]:overflow-y-auto! max-[62.5rem]:[.menu-dropdown--active>&]:pointer-events-auto! max-[62.5rem]:[.menu-dropdown--active>&]:delay-0!" aria-labelledby="menu-@Model.Id">
        @foreach (var menuItem in Model.Items)
        {
            @if (menuItem.ChildrenItems.Any())
            {
                @switch (menuItem.Template)
                {
                    case MenuItemTemplate.Grid:
                        @await Html.PartialAsync("~/Views/Shared/Components/MainMenu/_MenuItem.Grid.cshtml", menuItem)
                        break;
                    default:
                        @await Html.PartialAsync("~/Views/Shared/Components/MainMenu/_MenuItem.List.cshtml", menuItem)
                        break;
                }
            }
            else
            {
                <div class="menu__item @menuItem.CssClass" role="menuitem">
                    @await Html.PartialAsync("~/Views/Shared/Components/MainMenu/_MenuItem.cshtml", menuItem)
                </div>
            }
        }
    </div>
</nav>
