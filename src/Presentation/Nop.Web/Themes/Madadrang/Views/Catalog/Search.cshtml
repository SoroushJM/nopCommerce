@model SearchModel
@{
    Layout = "_MadadrangRoot";
    Context.Items["Madadrang.NativePage"] = true;
    NopHtml.AddTitleParts(T("PageTitle.Search").Text);
    NopHtml.AppendPageCssClassParts("html-search-page");
}
<main id="main-content" class="wrap py-8 sf-catalog">
    <p class="text-xs text-muted-foreground mb-5"><a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)">@T("Homepage")</a> / @T("Search")</p>
    <h1 class="page-heading">@T("Search")</h1>
    @await Html.PartialAsync("_MadadrangCatalogBody", Model)
</main>
