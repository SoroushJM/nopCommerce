    <p class="text-xs text-muted-foreground mb-5"><a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)">خانه</a> / سبد خرید</p>
    <h1 class="page-heading mb-7 text-3xl font-bold [letter-spacing:-0.0625rem] max-md:text-2xl">سبد خرید تو</h1>
    @if (!Model.OnePageCheckoutEnabled)
    {
        @await Component.InvokeAsync(typeof(CheckoutProgressViewComponent), new { step = CheckoutProgressStep.Cart })
    }
    @await Component.InvokeAsync(typeof(OrderSummaryViewComponent), new { overriddenModel = Model })
    @if (Model.Items.Count == 0)
    {
        <a class="sf-primary-action inline-flex mt-6" href="@Url.RouteUrl("MadadrangAllProducts")">یک انتخاب تازه پیدا کن ←</a>
    }
