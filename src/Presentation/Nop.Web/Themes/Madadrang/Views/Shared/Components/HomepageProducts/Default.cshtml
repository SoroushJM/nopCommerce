@model IList<ProductOverviewModel>
@if (Model.Count > 0)
{
    <section class="mt-12 max-md:mt-8">
        <div class="flex items-center justify-between mb-5">
            <div>
                <p class="text-xs text-accent-foreground mb-1">کوچک، کاربردی، دوست‌داشتنی</p>
                <h2 class="section-title text-2xl font-bold [letter-spacing:-0.0375rem] max-md:text-xl">انتخاب‌های محبوب</h2>
            </div>
            <a href="/stationery/catalog" class="flex gap-2 text-xs text-muted-foreground">همهٔ محصولات ←</a>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-md:gap-3">
            @foreach (var product in Model)
            {
                @await Html.PartialAsync("_ProductBox", product)
            }
        </div>
    </section>
}
