<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <ExcludedStorefrontViews Condition="'$(StorefrontTheme)' == 'Boutique'">../../Plugins/Nop.Plugin.Misc.PersianStorefront/Views/HomeHero.cshtml;../../Plugins/Nop.Plugin.Misc.PersianStorefront/Views/HomepageBanners.cshtml;../../Plugins/Nop.Plugin.Misc.PersianStorefront/Views/NativeHeader.cshtml;../../Plugins/Nop.Plugin.Misc.PersianStorefront/Views/NativeFooter.cshtml</ExcludedStorefrontViews>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Nop.Web/Nop.Web.csproj" />
    <ProjectReference Include="../../Plugins/Nop.Plugin.Misc.PersianStorefront/Nop.Plugin.Misc.PersianStorefront.csproj" />
    <ProjectReference Include="../../Plugins/Nop.Plugin.Payments.CheckMoneyOrder/Nop.Plugin.Payments.CheckMoneyOrder.csproj" />
    <ProjectReference Include="../../Plugins/Nop.Plugin.Shipping.FixedByWeightByTotal/Nop.Plugin.Shipping.FixedByWeightByTotal.csproj" />
    <ProjectReference Include="../../Plugins/Nop.Plugin.Tax.FixedOrByCountryStateZip/Nop.Plugin.Tax.FixedOrByCountryStateZip.csproj" />
    <ProjectReference Include="../../Plugins/Nop.Plugin.Widgets.Swiper/Nop.Plugin.Widgets.Swiper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Nop.Web/Views/**/*.cshtml" Link="Views/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../Nop.Web/Areas/Admin/Views/**/*.cshtml" Link="Areas/Admin/Views/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../Nop.Web/Themes/DefaultClean/**/*.cshtml" Link="Themes/DefaultClean/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../Nop.Web/Themes/Madadrang/**/*.cshtml" Link="Themes/Madadrang/%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(StorefrontTheme)' == 'Madadrang' Or '$(StorefrontTheme)' == 'All'" />
    <Content Include="../Nop.Web/Themes/Boutique/**/*.cshtml" Link="Themes/Boutique/%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(StorefrontTheme)' == 'Boutique' Or '$(StorefrontTheme)' == 'All'" />
    <Content Include="../../Plugins/Nop.Plugin.Misc.PersianStorefront/Views/**/*.cshtml" Link="Plugins/Misc.PersianStorefront/Views/%(RecursiveDir)%(Filename)%(Extension)" Exclude="$(ExcludedStorefrontViews)" />
    <Content Include="../../Plugins/Nop.Plugin.Payments.CheckMoneyOrder/Views/**/*.cshtml" Link="Plugins/Payments.CheckMoneyOrder/Views/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../Plugins/Nop.Plugin.Shipping.FixedByWeightByTotal/Views/**/*.cshtml" Link="Plugins/Shipping.FixedByWeightByTotal/Views/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../Plugins/Nop.Plugin.Tax.FixedOrByCountryStateZip/Views/**/*.cshtml" Link="Plugins/Tax.FixedOrByCountryStateZip/Views/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../Plugins/Nop.Plugin.Widgets.Swiper/Views/**/*.cshtml" Link="Plugins/Widgets.Swiper/Views/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="CollectPrecompiledViewPluginDependencies" AfterTargets="Build">
    <!-- Compiled views reference plugin model types even when that plugin is not installed.
         Export the actual Release reference assemblies so the host can resolve them beside this library. -->
    <ItemGroup>
      <PrecompiledViewPluginDependency Include="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('Nop.Plugin.')) and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <PrecompiledStorefrontPlugin Include="@(PrecompiledViewPluginDependency)"
          Condition="'%(PrecompiledViewPluginDependency.Filename)' == 'Nop.Plugin.Misc.PersianStorefront'" />
      <!-- The compiled views expose the storefront startup before a fresh installation has
           registered plugin folders. Its startup dependencies must also resolve beside the host. -->
      <PrecompiledViewRuntimeDependency Include="@(PrecompiledStorefrontPlugin->'%(RootDir)%(Directory)Microsoft.OpenApi.dll');@(PrecompiledStorefrontPlugin->'%(RootDir)%(Directory)Scalar.AspNetCore.dll');@(PrecompiledStorefrontPlugin->'%(RootDir)%(Directory)Swashbuckle.AspNetCore.Swagger.dll');@(PrecompiledStorefrontPlugin->'%(RootDir)%(Directory)Swashbuckle.AspNetCore.SwaggerGen.dll');@(PrecompiledStorefrontPlugin->'%(RootDir)%(Directory)Swashbuckle.AspNetCore.SwaggerUI.dll')" />
    </ItemGroup>
    <Error Condition="'@(PrecompiledViewPluginDependency)' == ''" Text="No plugin model dependencies were resolved for the precompiled native views." />
    <Copy SourceFiles="@(PrecompiledViewPluginDependency)"
          DestinationFolder="$(TargetDir)PrecompiledViewPluginDependencies/" SkipUnchangedFiles="true" />
    <Error Condition="'@(PrecompiledViewRuntimeDependency)' == ''" Text="No storefront startup dependencies were resolved for the precompiled native views." />
    <Copy SourceFiles="@(PrecompiledViewRuntimeDependency)"
          DestinationFolder="$(TargetDir)PrecompiledViewRuntimeDependencies/" SkipUnchangedFiles="true" />
  </Target>
</Project>
