<a class="mishashop-brand inline-flex! items-center! justify-center! text-[1.875rem]! font-[550]! leading-[1.5]! tracking-[-0.0625rem]! min-w-0! whitespace-nowrap! text-foreground! col-start-2! row-start-1! justify-self-center! max-[62.5rem]:col-start-1! max-[62.5rem]:justify-self-start! max-[62.5rem]:text-[1.5625rem]! max-[40rem]:text-[1.375rem]! max-[40rem]:tracking-[-0.040625rem]! max-[22.5rem]:text-[1.1875rem]! max-[22.5rem]:[.mishashop-header-row:has(.ico-inbox)_&]:text-[1rem]!" href="@HomeUrl" aria-label="@BrandName، صفحهٔ اصلی">
    @if (!string.IsNullOrWhiteSpace(LogoUrl))
    {
        <img src="@LogoUrl" alt="@BrandName" class="block! max-w-45! max-h-[3.375rem]! object-contain! max-[40rem]:max-w-[8.125rem]! max-[40rem]:max-h-11!" />
    }
    else
    {
        <span>@BrandName</span>
    }
</a>

@code {
    [Parameter] public string BrandName { get; set; } = "";
    [Parameter] public string HomeUrl { get; set; } = "/";
    [Parameter] public string LogoUrl { get; set; } = "";
}
