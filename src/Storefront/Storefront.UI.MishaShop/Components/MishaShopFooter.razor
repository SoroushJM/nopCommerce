<div class="mishashop-footer-brand flex! min-w-0! flex-col! items-start! gap-3! text-start!">
    <a href="@HomeUrl" class="text-[1.5rem]! font-medium! leading-[1.5]! text-foreground!">@BrandName</a>
    <p class="m-0! max-w-[20rem]! text-[0.8125rem]! leading-[1.8]! text-muted-foreground!">انتخاب‌هایی برای استایلِ خودت</p>
    @if (Menus.Count > 0)
    {
        <div class="mishashop-footer-menus flex! flex-wrap! gap-6! text-start! [&_a]:text-[0.8125rem]!">
            @foreach (var menu in Menus)
            {
                <nav aria-label="@menu.Name">
                    <h2 class="text-[0.8125rem]! font-medium! mb-3!">@menu.Name</h2>
                    @foreach (var item in menu.Items)
                    {
                        <StorefrontMenuBranch Item="item" Plain="true" />
                    }
                </nav>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string BrandName { get; set; } = "";
    [Parameter] public string HomeUrl { get; set; } = "/";
    [Parameter] public List<StoreMenu> Menus { get; set; } = [];
}
