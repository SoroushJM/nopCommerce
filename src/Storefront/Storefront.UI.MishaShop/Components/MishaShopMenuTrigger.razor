<BbDirectionProvider Direction="@(Menu.Rtl ? TextDirection.RightToLeft : TextDirection.LeftToRight)">
    <BbSheet @bind-Open="_open" Side="@(Menu.Rtl ? SheetSide.Right : SheetSide.Left)" Modal="true">
        <BbSheetTrigger AsChild="true">
            <BbButton id="@TriggerId" Type="ButtonType.Button" Variant="ButtonVariant.Ghost"
                      Class="menu__toggle !border-[0rem] !bg-none !text-foreground !rounded-[0.625rem] !text-[0.75rem] !font-medium min-[62.5625rem]:!hidden max-[62.5rem]:!inline-flex !items-center !justify-center !gap-[0.5rem] !w-auto !min-h-[2.75rem] !h-[2.75rem] !py-0 !px-[0.75rem] !m-0 !bg-secondary !cursor-pointer hover:!bg-secondary aria-expanded:!bg-primary aria-expanded:!text-primary-foreground focus-visible:!ring-[0rem] focus-visible:![outline:0.125rem_solid_var(--ring)] focus-visible:!outline-offset-[0.125rem]">
                <SfIcon Name="menu" Size="1.125m" />
                <span>@Menu.Labels.Get("Categories")</span>
            </BbButton>
        </BbSheetTrigger>
        <BbSheetContent ShowClose="false" LockScroll="true" TrapFocus="true" CloseOnEscape="true"
                        dir="@(Menu.Rtl ? "rtl" : "ltr")"
                        Class="!fixed !inset-0 !flex !h-dvh !max-h-dvh !w-full !max-w-none !flex-col !gap-0 !overflow-hidden !rounded-none !border-[0rem] !bg-background !p-0 !text-foreground !font-sans">
            <div class="flex shrink-0 items-center justify-between gap-[1rem] px-[1.25rem] pb-[1rem] pt-[max(1rem,env(safe-area-inset-top))]">
                <BbSheetHeader Class="!gap-[0.25rem] !p-0 !text-start">
                    <BbSheetTitle Class="!text-[1.25rem] !font-semibold !leading-[1.5]">@Menu.Labels.Get("Categories")</BbSheetTitle>
                    <BbSheetDescription Class="!m-0 !text-[0.8125rem] !text-muted-foreground">@Menu.Name</BbSheetDescription>
                </BbSheetHeader>
                <BbSheetClose AsChild="true">
                    <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Ghost" aria-label="@Menu.Labels.Get("Common.Close")"
                              Class="!flex !min-h-[2.75rem] !shrink-0 !items-center !gap-[0.5rem] !rounded-[0.625rem] !border-[0rem] !px-[0.75rem] !py-[0.5rem] !text-[0.8125rem] focus-visible:!ring-[0rem] focus-visible:![outline:0.125rem_solid_var(--ring)] focus-visible:!outline-offset-[0.125rem]">
                        <SfIcon Name="x" Size="1.125m" />
                        @Menu.Labels.Get("Common.Close")
                    </BbButton>
                </BbSheetClose>
            </div>
            <BbSeparator Class="!h-[0.0625rem] !shrink-0 !bg-border" />
            <nav aria-label="@Menu.Labels.Get("Categories")" class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-[1.25rem] pt-[0.75rem] pb-[max(1.5rem,env(safe-area-inset-bottom))]">
                <ul class="!m-0 !flex !list-none !flex-col !gap-[0.5rem] !p-0">
                    @foreach (var item in Menu.Items)
                    {
                        <MishaShopMobileMenuBranch Item="item" OnNavigate="CloseMenu" />
                    }
                </ul>
            </nav>
        </BbSheetContent>
    </BbSheet>
</BbDirectionProvider>

@code {
    [Parameter] public string TriggerId { get; set; } = "";
    [Parameter] public StoreMenu Menu { get; set; } = new();
    private bool _open;
    private void CloseMenu() => _open = false;
}
