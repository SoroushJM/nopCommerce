@typeparam TValue
<BbSelect TValue="TValue" Class="sf-select" AriaLabel="@Label" Value="@Value"
          ValueChanged="@ValueChanged" Disabled="Disabled" DisplayTextSelector="@GetDisplayText">
    <BbSelectTrigger TValue="TValue" Class="h-11">
        <BbSelectValue Placeholder="@Label" />
    </BbSelectTrigger>
    <BbSelectContent TValue="TValue">
        <BbSelectGroup>
            @foreach (var option in Options)
            {
                <BbSelectItem TValue="TValue" Value="@option.Value" Text="@option.Text" />
            }
        </BbSelectGroup>
    </BbSelectContent>
</BbSelect>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<SelectOption<TValue>> Options { get; set; } = [];

    private string GetDisplayText(TValue value) =>
        Options.FirstOrDefault(option => EqualityComparer<TValue>.Default.Equals(option.Value, value))?.Text ?? Label;
}
