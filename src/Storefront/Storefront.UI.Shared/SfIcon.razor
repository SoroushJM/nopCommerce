<BlazorBlueprint.Icons.Lucide.Components.LucideIcon Name="@IconName" Size="Size" StrokeWidth="1.7"
    aria-hidden="true" @attributes="AdditionalAttributes" />

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public string Name { get; set; } = "pencil";

    [Parameter]
    public int Size { get; set; } = 20;

    private string IconName => Name switch
    {
        "home" => "house",
        "bag" => "shopping-bag",
        "arrow" => "arrow-left",
        "shield" => "shield-check",
        "filter" => "list-filter",
        "trash" => "trash-2",
        "search" or "user" or "plus" or "minus" or "x" or "check" or "menu" or "star" or "leaf" => Name,
        _ => "pencil"
    };
}
