<BbFieldGroup>
    @if (Initial.Categories.Count > 0)
    {
        <BbField>
            <BbFieldLabel>@Initial.Labels.Get("Search.Category")</BbFieldLabel>
            <StoreSelect TValue="string" Label="@Initial.Labels.Get("Search.Category")" Options="Options(Initial.Categories)"
                         Value="Selected(Initial.Categories)" ValueChanged='value => Change.InvokeAsync(new("cid", value))' />
        </BbField>
    }
    @if (Initial.Manufacturers.Count > 0)
    {
        <BbFieldSet>
            <BbFieldLegend>@Initial.Labels.Get("Search.Manufacturer")</BbFieldLegend>
            @if (Initial.NativeSearch)
            {
                <StoreSelect TValue="string" Label="@Initial.Labels.Get("Filtering.ManufacturerFilter")" Options="Options(Initial.Manufacturers)"
                             Value="Selected(Initial.Manufacturers)" ValueChanged='value => Change.InvokeAsync(new("mid", value))' />
            }
            else
            {
                <BbFieldGroup>
                    @foreach (var option in Initial.Manufacturers)
                    {
                        <BbField Orientation="FieldOrientation.Horizontal">
                            <BbCheckbox Id="@(InstanceId + "-brand-" + option.Value)" Checked="option.Selected"
                                        CheckedChanged='value => Toggle("ms", option.Value, value)' AriaLabel="@option.Text" />
                            <BbFieldLabel For="@(InstanceId + "-brand-" + option.Value)">@option.Text</BbFieldLabel>
                        </BbField>
                    }
                </BbFieldGroup>
            }
        </BbFieldSet>
    }
    @if (Initial.PriceEnabled)
    {
        <BbFieldSet>
            <BbFieldLegend>@Initial.Labels.Get("Filtering.PriceRangeFilter") (@Initial.Currency)</BbFieldLegend>
            <BbFieldDescription><span dir="ltr">@Initial.AvailableFrom – @Initial.AvailableTo</span></BbFieldDescription>
            <BbFieldGroup Class="grid grid-cols-2 gap-2">
                <BbField IsInvalid="@(_error.Length > 0)">
                    <BbFieldLabel For="@(InstanceId + "-from")">≥ @Initial.Labels.Get("Products.Price")</BbFieldLabel>
                    <BbInput Id="@(InstanceId + "-from")" Class="h-11 text-left" dir="ltr" inputmode="decimal"
                             AriaInvalid="@(_error.Length > 0)" AriaDescribedBy="@(InstanceId + "-price-error")"
                             @bind-Value="_from" UpdateTiming="UpdateTiming.Immediate" />
                </BbField>
                <BbField IsInvalid="@(_error.Length > 0)">
                    <BbFieldLabel For="@(InstanceId + "-to")">≤ @Initial.Labels.Get("Products.Price")</BbFieldLabel>
                    <BbInput Id="@(InstanceId + "-to")" Class="h-11 text-left" dir="ltr" inputmode="decimal"
                             AriaInvalid="@(_error.Length > 0)" AriaDescribedBy="@(InstanceId + "-price-error")"
                             @bind-Value="_to" UpdateTiming="UpdateTiming.Immediate" />
                </BbField>
            </BbFieldGroup>
            @if (_error.Length > 0)
            {
                <BbFieldError Id="@(InstanceId + "-price-error")" role="alert">@_error</BbFieldError>
            }
            <BbButton Size="ButtonSize.Large" Class="w-full" OnClick="ApplyPrice">@Initial.Labels.Get("Common.Confirm")</BbButton>
        </BbFieldSet>
    }
    @foreach (var group in Initial.Specifications)
    {
        <BbFieldSet>
            <BbFieldLegend>@group.Name</BbFieldLegend>
            <BbFieldGroup>
                @foreach (var option in group.Options)
                {
                    <BbField Orientation="FieldOrientation.Horizontal">
                        <BbCheckbox Id="@(InstanceId + "-spec-" + option.Value)" Checked="option.Selected"
                                    CheckedChanged='value => Toggle("specs", option.Value, value)' AriaLabel="@option.Text" />
                        <BbFieldLabel For="@(InstanceId + "-spec-" + option.Value)">
                            @if (option.Color.Length > 0)
                            {
                                <span class="size-3 rounded-full border border-border" style="background:@option.Color"></span>
                            }
                            @option.Text
                        </BbFieldLabel>
                    </BbField>
                }
            </BbFieldGroup>
        </BbFieldSet>
    }
    <BbButton Variant="ButtonVariant.Ghost" Class="w-full" OnClick='() => Change.InvokeAsync(new("reset", null))'>@Initial.Labels.Get("Common.Remove")</BbButton>
</BbFieldGroup>
