@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<BbDirectionProvider Direction="@(Labels.Rtl ? TextDirection.RightToLeft : TextDirection.LeftToRight)">
<BbDialog Open="_zoomOpen" OpenChanged="SetZoomOpen">
    <div class="@(QuickPurchase ? "storefront sf-quick-purchase [&_.sf-price-card]:gap-0! [&_.sf-price-card]:min-h-0! [&_.sf-price-card]:h-auto!" : "storefront")" dir="@Labels.Direction">
        @foreach (var field in FormFields().Where(_ => !QuickPurchase))
        {
            <input type="hidden" id="@field.Key.Replace('.', '_')" name="@field.Key" value="@field.Value" />
        }
        <main id="@(QuickPurchase ? null : "main-content")">
            <section class="@(QuickPurchase ? "min-w-0" : "wrap mx-auto max-w-[80rem] px-8 max-md:px-5 [.mishashop-shell_&]:w-[calc(100%-2.5rem)] [.mishashop-shell_&]:max-w-[73.75rem] [.mishashop-shell_&]:px-0 max-md:[.mishashop-shell_&]:w-[calc(100%-1.75rem)] py-7")">
                @if (!QuickPurchase && Initial.BreadcrumbEnabled)
                {
                <BbBreadcrumb Class="sf-product-breadcrumb [&_ol]:text-xs text-xs text-muted-foreground mb-7" aria-label="@Initial.Name">
                    <BbBreadcrumbItem><BbBreadcrumbLink Href="@Initial.HomeUrl">@Labels.Get("Homepage")</BbBreadcrumbLink></BbBreadcrumbItem>
                    <BbBreadcrumbSeparator>/</BbBreadcrumbSeparator>
                    @foreach (var link in Initial.Breadcrumb)
                    {
                        <BbBreadcrumbItem><BbBreadcrumbLink Href="@link.Url">@link.Name</BbBreadcrumbLink></BbBreadcrumbItem>
                        <BbBreadcrumbSeparator>/</BbBreadcrumbSeparator>
                    }
                    <BbBreadcrumbItem><BbBreadcrumbPage>@Initial.Name</BbBreadcrumbPage></BbBreadcrumbItem>
                </BbBreadcrumb>
                }
                @if (_error.Length > 0)
                {
                    <BbAlert Variant="AlertVariant.Danger" Class="mb-5">@_error</BbAlert>
                }
                <div class="@(QuickPurchase ? "grid grid-cols-1 gap-4" : "grid grid-cols-1 md:grid-cols-2 gap-12 max-md:gap-7")">
                    @if (!QuickPurchase)
                    {
                    <div @ref="_gallery" class="sf-product-gallery min-w-0">
                        <BbCard Class="sf-product-image aspect-square overflow-hidden [&>div]:h-full [.mishashop-shell_&]:aspect-auto [.mishashop-shell_&]:rounded-2xl [.mishashop-shell_&]:border-[0rem] [.mishashop-shell_&]:bg-muted">
                            <BbCardHeader Class="absolute size-[.0625rem] -m-[.0625rem] overflow-hidden whitespace-nowrap border-[0rem] p-0 [clip-path:inset(50%)]"><BbCardTitle>@Labels.Format("Media.Product.ImageAlternateTextFormat.Details", Initial.Name)</BbCardTitle></BbCardHeader>
                            <BbCardContent Class="p-0">
                            @if (Initial.ZoomEnabled && !string.IsNullOrEmpty(_fullSizeImage))
                            {
                                <BbDialogTrigger AsChild="false" class="sf-product-zoom block h-full w-full cursor-zoom-in" aria-label="@Labels.Format("Media.Product.ImageLinkTitleFormat.Details", Initial.Name)">
                                    <img class="h-full w-full object-contain [.mishashop-shell_&]:aspect-[3/4] [.mishashop-shell_&]:h-auto [.mishashop-shell_&]:object-cover" src="@_image" alt="@_imageAlt" title="@_imageTitle" />
                                </BbDialogTrigger>
                            }
                            else
                            {
                                <img class="h-full w-full object-contain [.mishashop-shell_&]:aspect-[3/4] [.mishashop-shell_&]:h-auto [.mishashop-shell_&]:object-cover" src="@_image" alt="@_imageAlt" title="@_imageTitle" />
                            }
                            </BbCardContent>
                        </BbCard>
                        @if (Initial.Pictures.Count > 1)
                        {
                            <div class="sf-product-thumbnails mt-4 flex flex-wrap gap-3 [.mishashop-shell_&]:gap-2.5" aria-label="@Labels.Format("Media.Product.ImageAlternateTextFormat.Details", Initial.Name)">
                                @foreach (var picture in VisiblePictures)
                                {
                                    <button type="button" class="@ClassNames.cn("size-[4.5rem] overflow-hidden rounded-md border-[0.125rem] bg-background p-1 [.mishashop-shell_&]:h-auto [.mishashop-shell_&]:w-16 [.mishashop-shell_&]:rounded-lg [.mishashop-shell_&]:border-[.0625rem] [.mishashop-shell_&]:p-0", _image == picture.Image ? "selected border-primary [.mishashop-shell_&]:border-ring" : "border-border")"
                                            aria-label="@picture.Title" aria-pressed="@((_image == picture.Image).ToString().ToLowerInvariant())"
                                            @onclick="() => SelectPicture(picture)">
                                        <img class="h-full w-full object-contain [.mishashop-shell_&]:aspect-[3/4] [.mishashop-shell_&]:h-auto [.mishashop-shell_&]:object-cover" src="@picture.Thumbnail" alt="@picture.Alt" loading="lazy" />
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    }
                    <div class="min-w-0">
                        @if (!QuickPurchase)
                        {
                        <p class="text-xs text-primary mb-3">
                            @foreach (var manufacturer in Initial.Manufacturers)
                            {
                                <a class="mr-2" href="@manufacturer.Url">@manufacturer.Name</a>
                            }
                        </p>
                        <h1 class="sf-product-name [overflow-wrap:anywhere] text-3xl max-md:text-2xl font-bold leading-relaxed">@Initial.Name</h1>
                        <p class="text-sm text-muted-foreground leading-8 mt-4">@((MarkupString)Initial.Description)</p>
                        }
                        @if (StockLabel.Length > 0)
                        {
                            <BbBadge Variant="@(StockAvailable ? BadgeVariant.SoftSuccess : BadgeVariant.SoftWarning)" Class="@(QuickPurchase ? "sf-product-stock mb-3 [overflow-wrap:anywhere]" : "sf-product-stock mt-5 [overflow-wrap:anywhere]")">@StockLabel</BbBadge>
                        }
                        @if (!QuickPurchase)
                        {
                        <dl class="sf-product-metadata mt-4 flex flex-wrap gap-x-6 gap-y-3 text-xs [&_div]:flex [&_div]:gap-2 [&_dt]:text-muted-foreground [&_dd]:[overflow-wrap:anywhere]">
                            @if (Initial.ShowSku && _sku.Length > 0)
                            {
                                <div><dt>@Labels.Get("Products.Sku")</dt><dd data-product-sku>@_sku</dd></div>
                            }
                            @if (Initial.ShowMpn && _mpn.Length > 0)
                            {
                                <div><dt>@Labels.Get("Products.ManufacturerPartNumber")</dt><dd>@_mpn</dd></div>
                            }
                            @if (Initial.ShowGtin && _gtin.Length > 0)
                            {
                                <div><dt>@Labels.Get("Products.GTIN")</dt><dd>@_gtin</dd></div>
                            }
                            @if (Initial.ShowVendor && Initial.Vendor != null)
                            {
                                <div><dt>@Labels.Get("Products.Vendor")</dt><dd><a href="@Initial.Vendor.Url">@Initial.Vendor.Name</a></dd></div>
                            }
                        </dl>
                        @if (Initial.IsShipEnabled)
                        {
                            @if (_freeShipping && Initial.FreeShippingNotificationEnabled)
                            {
                                <p class="sf-product-delivery mt-3 text-xs text-success">@Labels.Get("Products.FreeShipping")</p>
                            }
                            @if (Initial.DeliveryDate.Length > 0)
                            {
                                <p class="sf-product-delivery mt-3 text-xs text-success">@Labels.Get("Products.DeliveryDate"): @Initial.DeliveryDate</p>
                            }
                        }
                        <BbSeparator Class="sf-product-separator my-6 h-[.0625rem] bg-border" />
                        }
                        @foreach (var attribute in Initial.Attributes.Where(item =>
                        !_disabledAttributes.Contains(item.Id)))
                        {
                            <fieldset @key="attribute.Id" class="@(QuickPurchase ? "min-w-0 mb-4" : "mb-6")">
                                <legend class="@(QuickPurchase ? "text-sm font-bold mb-2 leading-6" : "text-sm font-bold mb-3")">@AttributePrompt(attribute)
                                    @if (attribute.Required)
                                    {
                                        <span class="required text-destructive">*</span>
                                    }
                                    : <span class="font-normal text-muted-foreground">@(attribute.Options.FirstOrDefault(option =>
                                    option.Id == _selected.GetValueOrDefault(attribute.Id)) is { } selectedOption ? OptionLabel(selectedOption) : "")</span></legend>
                                @if (!string.IsNullOrEmpty(attribute.Description))
                                {
                                    <div class="attribute-description mb-3 text-xs leading-relaxed text-muted-foreground">@((MarkupString)attribute.Description)</div>
                                }
                                    @if (attribute.ControlType == 1)
                                    {
                                        <StoreSelect TValue="int" Label="@AttributePrompt(attribute)" Options="@AttributeOptions(attribute)"
                                                     Value="_selected.GetValueOrDefault(attribute.Id)"
                                                     ValueChanged="value => SelectOption(attribute.Id, value)" Disabled="@(!_ready || _busy)" />
                                }
                                else
                                {
                                    <BlazorBlueprint.Primitives.RadioGroup.BbRadioGroup TValue="int"
                                        Value="_selected.GetValueOrDefault(attribute.Id)"
                                        ValueChanged="value => SelectOption(attribute.Id, value)"
                                        Disabled="@(!_ready || _busy)" Required="attribute.Required"
                                        AriaLabel="@AttributePrompt(attribute)" class="@(QuickPurchase ? "flex flex-wrap gap-2 [&_.color-choice]:size-11! [&_.color-choice]:p-1.5! [&_.color-choice]:border-[.0625rem]! [&_.color-choice]:[background-clip:content-box]! [&_.color-choice]:outline-offset-[0rem]! [&_.filter-pill]:min-h-11! [&_.filter-pill]:px-3! [&_.filter-pill]:py-2!" : "flex flex-wrap gap-4")">
                                        @foreach (var option in attribute.Options)
                                        {
                                            <BlazorBlueprint.Primitives.RadioGroup.BbRadioGroupItem @key="option.Id" TValue="int" Value="option.Id"
                                                    class="@ClassNames.cn(attribute.ControlType is 40 or 45 ? "color-choice grid size-[2.125rem] place-items-center overflow-hidden rounded-[9999rem] border-[0.1875rem] border-background text-primary-foreground outline-[0.0625rem] outline-input disabled:opacity-30 focus-visible:ring-[0.125rem] focus-visible:ring-ring [.mishashop-shell_&]:size-8 [.mishashop-shell_&]:border-card [.mishashop-shell_&]:outline-border" : "filter-pill rounded-md border-[.0625rem] border-border bg-background px-3.5 py-[0.5625rem] text-xs [.mishashop-shell_&]:rounded-[9999rem] [.mishashop-shell_&]:bg-secondary [.mishashop-shell_&]:px-5 [.mishashop-shell_&]:py-2", attribute.ControlType == 40 ? "bg-(--swatch-color)" : null, _selected.GetValueOrDefault(attribute.Id) == option.Id ? attribute.ControlType is 40 or 45 ? "selected outline-[0.125rem] outline-primary outline-offset-[0.1875rem] [.mishashop-shell_&]:outline-offset-[0rem]" : "selected border-primary bg-secondary text-primary [.mishashop-shell_&]:bg-accent" : null)"
                                                    style="@(attribute.ControlType == 40 ? "--swatch-color:" + option.Color : "")"
                                                    AriaLabel="@($"{AttributePrompt(attribute)} {OptionLabel(option)}")"
                                                    title="@OptionLabel(option)"
                                                    tabindex="@AttributeOptionTabIndex(attribute, option)">
                                                @if (attribute.ControlType == 45)
                                                {
                                                    <img class="h-full w-full object-cover" src="@option.Image" alt="@OptionLabel(option)" />
                                                }
                                                else if (attribute.ControlType != 40)
                                                {

                                                    @OptionLabel(option)
                                                }
                                                else if (_selected.GetValueOrDefault(attribute.Id) == option.Id)
                                                {
                                                    <SfIcon Name="check" Size="1m" />
                                                }
                                            </BlazorBlueprint.Primitives.RadioGroup.BbRadioGroupItem>
                                        }
                                    </BlazorBlueprint.Primitives.RadioGroup.BbRadioGroup>
                                }
                            </fieldset>
                        }
                        @if (!Initial.DisableBuy)
                        {
                        <div class="@(QuickPurchase ? "flex flex-wrap items-center gap-3 mb-4 [&_.sf-quantity]:h-11! [&_.sf-quantity_button]:h-11! [&_.sf-quantity_button]:w-11! [&_.sf-product-quantity-input]:w-12! [&_.sf-product-quantity-input]:h-11! [&_.sf-product-quantity-input]:p-0!" : "flex items-center gap-5 mb-6")">
                            <span class="text-sm">@Labels.Get("Products.Qty")</span>
                            @if (Initial.Quantities.Count > 0)
                            {
                                <BbSelect TValue="int" Value="_quantity" ValueChanged="ChangeQuantity" AriaLabel="@Labels.Get("Products.Qty.AriaLabel")" Disabled="@(!_ready || _busy)">
                                    <BbSelectTrigger Class="sf-select h-11 min-h-[var(--control-height)] text-start [&>span]:truncate">
                                        <BbSelectValue />
                                    </BbSelectTrigger>
                                    <BbSelectContent>
                                                <BbSelectGroup>@foreach (var value in Initial.Quantities) {
                                        <BbSelectItem Value="value">@value</BbSelectItem>
                                    }
                                </BbSelectGroup>
                                        </BbSelectContent>
                            </BbSelect>
                        }
                            else
                        {
                            <BbButtonGroup Class="sf-quantity qty inline-flex items-center rounded-md border-[.0625rem] border-border bg-background [&_button]:grid [&_button]:h-[var(--control-height)] [&_button]:w-10 [&_button]:place-items-center [&_span]:min-w-[1.875rem] [&_span]:text-center [&_span]:text-sm"><button aria-label="@(Labels.Get("Products.Qty") + " −")"
                                                                           disabled="@(_quantity <= Initial.MinimumQuantity || !_ready || _busy || _updating)"
                                                                           @onclick="() => ChangeQuantity(_quantity - 1)">
                                <SfIcon Name="minus" Size="0.875m" />
                        </button><input @key="_quantityInputRevision" @ref="_quantityInput" class="sf-product-quantity-input w-16 min-w-0 text-center text-sm" type="number" aria-label="@Labels.Get("Products.Qty.AriaLabel")"
                                            min="@Initial.MinimumQuantity" step="1" value="@_quantity" @onchange="EnterQuantity"
                                            disabled="@(!_ready || _busy || _updating)" /><button aria-label="@(Labels.Get("Products.Qty") + " +")" disabled="@(!_ready || _busy || _updating)"
                                                                @onclick="() => ChangeQuantity(_quantity + 1)">
                            <SfIcon Name="plus" Size="0.875m" />
                        </button></BbButtonGroup>
                    }
                </div>
                @if (Initial.MinimumQuantityNotification.Length > 0)
                {
                    <p class="text-xs text-muted-foreground mb-4">@Initial.MinimumQuantityNotification</p>
                }
                        }
                @if (DisplayTierPrices)
                {
                    <div class="sf-product-tiers mb-6 rounded-md border-[.0625rem] border-border p-4 text-xs [&_h2]:mb-3 [&_h2]:font-bold [&_table]:w-full [&_td]:border-b-[.0625rem] [&_td]:border-border [&_td]:py-2 [&_td]:text-start [&_th]:border-b-[.0625rem] [&_th]:border-border [&_th]:py-2 [&_th]:text-start">
                        <h2>@Labels.Get("Products.TierPrices")</h2>
                        <table><thead><tr><th>@Labels.Get("Products.TierPrices.Quantity")</th><th>@Labels.Get("Products.TierPrices.Price")</th></tr></thead><tbody>
                            @foreach (var tier in Initial.TierPrices)
                            {
                                <tr><td>@(tier.Quantity)+</td><td>@tier.Price</td></tr>
                            }
                        </tbody></table>
                    </div>
                }
                @if (!Initial.HidePrices || !Initial.DisableBuy)
                {
                <BbCard Class="@(QuickPurchase ? "sf-price-card flex flex-col gap-0! rounded-lg border-[.0625rem]! border-border bg-muted/40 shadow-none!" : "sf-price-card rounded-xl border-[.0625rem] border-border bg-card")">
                    <BbCardHeader Class="absolute size-[.0625rem] -m-[.0625rem] overflow-hidden whitespace-nowrap border-[0rem] p-0 [clip-path:inset(50%)]"><BbCardTitle>@Initial.PurchaseLabel @Initial.Name</BbCardTitle></BbCardHeader>
                    <BbCardContent Class="@(QuickPurchase ? "p-3! min-h-0! space-y-2 [&_p]:mb-0!" : "pt-6")">
                    @if (!Initial.HidePrices)
                    {
                    @if (Initial.CallForPrice)
                    {
                        <p class="mb-5 font-bold">@Initial.CallForPriceLabel</p>
                    }
                    else
                    {
                    <div class="@(QuickPurchase ? "flex items-center justify-between gap-3 mb-0! [&_del]:leading-5!" : "flex items-end justify-between mb-5")"><span class="text-xs text-muted-foreground">@Labels.Get("Products.Price")</span>
                        <div class="@(QuickPurchase ? "flex flex-col items-end gap-0.5 text-end [&_del]:m-0!" : "text-end")">@if (!string.IsNullOrWhiteSpace(Initial.OldPrice)) {
                            <del class="text-xs text-muted-foreground block mb-1">@Initial.OldPrice</del>
                        }
                        <strong class="@(QuickPurchase ? "price m-0! text-xl! leading-7!" : "text-2xl price")">@_price</strong>
                        @if (Initial.ReferencePrice.Length > 0)
                        {
                            <del class="text-xs text-muted-foreground block">@Initial.ReferencePrice</del>
                        }
                    </div>
                </div>
                    @if (_basePrice.Length > 0)
                    {
                        <p class="text-xs text-muted-foreground mb-4">@_basePrice</p>
                    }
                    @if (Initial.TaxShippingInfo.Length > 0)
                    {
                        <p class="text-xs text-muted-foreground mb-4">@((MarkupString)Initial.TaxShippingInfo)</p>
                    }
                    }
                    }
                    </BbCardContent>
                @if (!Initial.DisableBuy)
                {
                    <BbCardFooter Class="@(QuickPurchase ? "p-3! pt-0!" : null)">
                <BbButton Size="@(QuickPurchase ? ButtonSize.Default : ButtonSize.Large)" Class="@(QuickPurchase ? "w-full h-11! min-h-11! rounded-md text-sm! gap-2! [&_svg]:size-4!" : "w-full")" Disabled="@(!Available || _busy || _updating || !_ready || !_selectionReady)"
                          Loading="_busy" OnClick="AddToCart">
                    <SfIcon Name="bag" data-icon="inline-start" /><span>@PurchaseLabel</span>
                </BbButton>
                    </BbCardFooter>
                }
            </BbCard>
                }
            @if (Initial.PreOrderDate.Length > 0)
            {
                <p class="text-xs text-muted-foreground mt-4">@Labels.Get("ShoppingCart.PreOrderAvailability"): @Initial.PreOrderDate</p>
            }
        </div>
    </div>
</section>
</main>

</div>
    <BbDialogContent Class="sf-product-image-dialog w-[min(56.25rem,calc(100vw-2rem))] max-w-none max-h-[calc(100dvh-2rem)] overflow-y-auto" ShowClose="false" dir="@Labels.Direction">
        <BbDialogClose AsChild="false" class="absolute top-4 end-4" aria-label="@Labels.Get("Common.Close")"><SfIcon Name="x" /></BbDialogClose>
        <BbDialogHeader>
            <BbDialogTitle>@Initial.Name</BbDialogTitle>
            <BbDialogDescription>@Labels.Format("Media.Product.ImageAlternateTextFormat.Details", Initial.Name)</BbDialogDescription>
        </BbDialogHeader>
        <img class="max-h-[70dvh] w-full object-contain" src="@_fullSizeImage" alt="@_imageAlt" title="@_imageTitle" />
    </BbDialogContent>
</BbDialog>
</BbDirectionProvider>
