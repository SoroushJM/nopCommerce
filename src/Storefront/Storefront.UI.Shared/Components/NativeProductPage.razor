@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<BbDirectionProvider Direction="@(Labels.Rtl ? TextDirection.RightToLeft : TextDirection.LeftToRight)">
<BbDialog Open="_zoomOpen" OpenChanged="SetZoomOpen">
    <div class="storefront" dir="@Labels.Direction">
        @foreach (var field in FormFields())
        {
            <input type="hidden" id="@field.Key.Replace('.', '_')" name="@field.Key" value="@field.Value" />
        }
        <main id="main-content">
            <section class="wrap py-7">
                @if (Initial.BreadcrumbEnabled)
                {
                <p class="text-xs text-muted-foreground mb-7"><a href="@Initial.HomeUrl">@Labels.Get("Homepage")</a> / @foreach (var link in Initial.Breadcrumb)
                    {
                        <a href="@link.Url">@link.Name</a><span> / </span>
                    }
                    @Initial.Name
                </p>
                }
                @if (_error.Length > 0)
                {
                    <BbAlert Variant="AlertVariant.Danger" Class="mb-5">@_error</BbAlert>
                }
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-md:gap-7">
                    <div @ref="_gallery" class="sf-product-gallery">
                        <BbCard Class="sf-product-image">
                            <BbCardHeader Class="sr-only"><BbCardTitle>@Labels.Format("Media.Product.ImageAlternateTextFormat.Details", Initial.Name)</BbCardTitle></BbCardHeader>
                            <BbCardContent Class="p-0">
                            @if (Initial.ZoomEnabled && !string.IsNullOrEmpty(_fullSizeImage))
                            {
                                <BbDialogTrigger AsChild="false" class="sf-product-zoom" aria-label="@Labels.Format("Media.Product.ImageLinkTitleFormat.Details", Initial.Name)">
                                    <img src="@_image" alt="@_imageAlt" title="@_imageTitle" />
                                </BbDialogTrigger>
                            }
                            else
                            {
                                <img src="@_image" alt="@_imageAlt" title="@_imageTitle" />
                            }
                            </BbCardContent>
                        </BbCard>
                        @if (Initial.Pictures.Count > 1)
                        {
                            <div class="sf-product-thumbnails" aria-label="@Labels.Format("Media.Product.ImageAlternateTextFormat.Details", Initial.Name)">
                                @foreach (var picture in VisiblePictures)
                                {
                                    <button type="button" class="@(_image == picture.Image ? "selected" : "")"
                                            aria-label="@picture.Title" aria-pressed="@((_image == picture.Image).ToString().ToLowerInvariant())"
                                            @onclick="() => SelectPicture(picture)">
                                        <img src="@picture.Thumbnail" alt="@picture.Alt" loading="lazy" />
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs text-primary mb-3">
                            @foreach (var manufacturer in Initial.Manufacturers)
                            {
                                <a class="mr-2" href="@manufacturer.Url">@manufacturer.Name</a>
                            }
                        </p>
                        <h1 class="sf-product-name text-3xl max-md:text-2xl font-bold leading-relaxed">@Initial.Name</h1>
                        <p class="text-sm text-muted-foreground leading-8 mt-4">@((MarkupString)Initial.Description)</p>
                        @if (StockLabel.Length > 0)
                        {
                            <BbBadge Variant="@(StockAvailable ? BadgeVariant.SoftSuccess : BadgeVariant.SoftWarning)" Class="sf-product-stock mt-5">@StockLabel</BbBadge>
                        }
                        <dl class="sf-product-metadata">
                            @if (Initial.ShowSku && _sku.Length > 0)
                            {
                                <div><dt>@Labels.Get("Products.Sku")</dt><dd data-product-sku>@_sku</dd></div>
                            }
                            @if (Initial.ShowMpn && _mpn.Length > 0)
                            {
                                <div><dt>@Labels.Get("Products.ManufacturerPartNumber")</dt><dd>@_mpn</dd></div>
                            }
                            @if (Initial.ShowGtin && _gtin.Length > 0)
                            {
                                <div><dt>@Labels.Get("Products.GTIN")</dt><dd>@_gtin</dd></div>
                            }
                            @if (Initial.ShowVendor && Initial.Vendor != null)
                            {
                                <div><dt>@Labels.Get("Products.Vendor")</dt><dd><a href="@Initial.Vendor.Url">@Initial.Vendor.Name</a></dd></div>
                            }
                        </dl>
                        @if (Initial.IsShipEnabled)
                        {
                            @if (_freeShipping && Initial.FreeShippingNotificationEnabled)
                            {
                                <p class="sf-product-delivery">@Labels.Get("Products.FreeShipping")</p>
                            }
                            @if (Initial.DeliveryDate.Length > 0)
                            {
                                <p class="sf-product-delivery">@Labels.Get("Products.DeliveryDate"): @Initial.DeliveryDate</p>
                            }
                        }
                        <BbSeparator Class="sf-product-separator my-6" />
                        @foreach (var attribute in Initial.Attributes.Where(item =>
                        !_disabledAttributes.Contains(item.Id)))
                        {
                            <fieldset class="mb-6">
                                <legend class="text-sm font-bold mb-3">@AttributePrompt(attribute)
                                    @if (attribute.Required)
                                    {
                                        <span class="required">*</span>
                                    }
                                    : <span class="font-normal text-muted-foreground">@(attribute.Options.FirstOrDefault(option =>
                                    option.Id == _selected.GetValueOrDefault(attribute.Id)) is { } selectedOption ? OptionLabel(selectedOption) : "")</span></legend>
                                @if (!string.IsNullOrEmpty(attribute.Description))
                                {
                                    <div class="attribute-description">@((MarkupString)attribute.Description)</div>
                                }
                                    @if (attribute.ControlType == 1)
                                    {
                                        <StoreSelect TValue="int" Label="@AttributePrompt(attribute)" Options="@AttributeOptions(attribute)"
                                                     Value="_selected.GetValueOrDefault(attribute.Id)"
                                                     ValueChanged="value => SelectOption(attribute.Id, value)" Disabled="@(!_ready || _busy)" />
                                }
                                else
                                {
                                    <div class="flex gap-4">
                                        @foreach (var option in attribute.Options)
                                        {
                                            <button type="button"
                                                    class="@ClassNames.cn(attribute.ControlType is 40 or 45 ? "color-choice" : "filter-pill", _selected.GetValueOrDefault(attribute.Id) == option.Id ? "selected" : null)"
                                                    style="@(attribute.ControlType == 40 ? "background:" + option.Color : "")"
                                                    disabled="@(!_ready || _busy)"
                                                    aria-label="@($"{AttributePrompt(attribute)} {OptionLabel(option)}")"
                                                    title="@OptionLabel(option)"
                                                    aria-pressed="@((_selected.GetValueOrDefault(attribute.Id) == option.Id).ToString().ToLowerInvariant())"
                                                    @onclick="() => SelectOption(attribute.Id, option.Id)">
                                                @if (attribute.ControlType == 45)
                                                {
                                                    <img src="@option.Image" alt="@OptionLabel(option)" />
                                                }
                                                else if (attribute.ControlType != 40)
                                                {

                                                    @OptionLabel(option)
                                                }
                                                else if (_selected.GetValueOrDefault(attribute.Id) == option.Id)
                                                {
                                                    <SfIcon Name="check" Size="16" />
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </fieldset>
                        }
                        @if (!Initial.DisableBuy)
                        {
                        <div class="flex items-center gap-5 mb-6">
                            <span class="text-sm">@Labels.Get("Products.Qty")</span>
                            @if (Initial.Quantities.Count > 0)
                            {
                                <BbSelect TValue="int" Value="_quantity" ValueChanged="ChangeQuantity" AriaLabel="@Labels.Get("Products.Qty.AriaLabel")" Disabled="@(!_ready || _busy)">
                                    <BbSelectTrigger Class="sf-select h-11">
                                        <BbSelectValue />
                                    </BbSelectTrigger>
                                    <BbSelectContent>
                                                <BbSelectGroup>@foreach (var value in Initial.Quantities) {
                                        <BbSelectItem Value="value">@value</BbSelectItem>
                                    }
                                </BbSelectGroup>
                                        </BbSelectContent>
                            </BbSelect>
                        }
                            else
                        {
                            <BbButtonGroup Class="sf-quantity qty"><button aria-label="@(Labels.Get("Products.Qty") + " −")"
                                                                           disabled="@(_quantity <= Initial.MinimumQuantity || !_ready || _busy || _updating)"
                                                                           @onclick="() => ChangeQuantity(_quantity - 1)">
                                <SfIcon Name="minus" Size="14" />
                        </button><input @key="_quantityInputRevision" @ref="_quantityInput" class="sf-product-quantity-input" type="number" aria-label="@Labels.Get("Products.Qty.AriaLabel")"
                                            min="@Initial.MinimumQuantity" step="1" value="@_quantity" @onchange="EnterQuantity"
                                            disabled="@(!_ready || _busy || _updating)" /><button aria-label="@(Labels.Get("Products.Qty") + " +")" disabled="@(!_ready || _busy || _updating)"
                                                                @onclick="() => ChangeQuantity(_quantity + 1)">
                            <SfIcon Name="plus" Size="14" />
                        </button></BbButtonGroup>
                    }
                </div>
                @if (Initial.MinimumQuantityNotification.Length > 0)
                {
                    <p class="text-xs text-muted-foreground mb-4">@Initial.MinimumQuantityNotification</p>
                }
                        }
                @if (DisplayTierPrices)
                {
                    <div class="sf-product-tiers">
                        <h2>@Labels.Get("Products.TierPrices")</h2>
                        <table><thead><tr><th>@Labels.Get("Products.TierPrices.Quantity")</th><th>@Labels.Get("Products.TierPrices.Price")</th></tr></thead><tbody>
                            @foreach (var tier in Initial.TierPrices)
                            {
                                <tr><td>@(tier.Quantity)+</td><td>@tier.Price</td></tr>
                            }
                        </tbody></table>
                    </div>
                }
                @if (!Initial.HidePrices || !Initial.DisableBuy)
                {
                <BbCard Class="sf-price-card">
                    <BbCardHeader Class="sr-only"><BbCardTitle>@Initial.PurchaseLabel @Initial.Name</BbCardTitle></BbCardHeader>
                    <BbCardContent Class="pt-6">
                    @if (!Initial.HidePrices)
                    {
                    @if (Initial.CallForPrice)
                    {
                        <p class="mb-5 font-bold">@Initial.CallForPriceLabel</p>
                    }
                    else
                    {
                    <div class="flex items-end justify-between mb-5"><span class="text-xs text-muted-foreground">@Labels.Get("Products.Price")</span>
                        <div class="text-end">@if (!string.IsNullOrWhiteSpace(Initial.OldPrice)) {
                            <del class="text-xs text-muted-foreground block mb-1">@Initial.OldPrice</del>
                        }
                        <strong class="text-2xl price">@_price</strong>
                        @if (Initial.ReferencePrice.Length > 0)
                        {
                            <del class="text-xs text-muted-foreground block">@Initial.ReferencePrice</del>
                        }
                    </div>
                </div>
                    @if (_basePrice.Length > 0)
                    {
                        <p class="text-xs text-muted-foreground mb-4">@_basePrice</p>
                    }
                    @if (Initial.TaxShippingInfo.Length > 0)
                    {
                        <p class="text-xs text-muted-foreground mb-4">@((MarkupString)Initial.TaxShippingInfo)</p>
                    }
                    }
                    }
                    </BbCardContent>
                @if (!Initial.DisableBuy)
                {
                    <BbCardFooter>
                <BbButton Size="ButtonSize.Large" Class="w-full" Disabled="@(!Available || _busy || _updating || !_ready || !_selectionReady)"
                          Loading="_busy" OnClick="AddToCart">
                    <SfIcon Name="bag" data-icon="inline-start" /><span>@PurchaseLabel</span>
                </BbButton>
                    </BbCardFooter>
                }
            </BbCard>
                }
            @if (Initial.PreOrderDate.Length > 0)
            {
                <p class="text-xs text-muted-foreground mt-4">@Labels.Get("ShoppingCart.PreOrderAvailability"): @Initial.PreOrderDate</p>
            }
        </div>
    </div>
</section>
</main>

</div>
    <BbDialogContent Class="sf-product-image-dialog" ShowClose="false" dir="@Labels.Direction">
        <BbDialogClose AsChild="false" class="absolute top-4 end-4" aria-label="@Labels.Get("Common.Close")"><SfIcon Name="x" /></BbDialogClose>
        <BbDialogHeader>
            <BbDialogTitle>@Initial.Name</BbDialogTitle>
            <BbDialogDescription>@Labels.Format("Media.Product.ImageAlternateTextFormat.Details", Initial.Name)</BbDialogDescription>
        </BbDialogHeader>
        <img src="@_fullSizeImage" alt="@_imageAlt" title="@_imageTitle" />
    </BbDialogContent>
</BbDialog>
</BbDirectionProvider>
