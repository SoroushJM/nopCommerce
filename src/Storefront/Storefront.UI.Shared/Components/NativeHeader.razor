@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
<BbDirectionProvider Direction="TextDirection.RightToLeft">
    <BbPortalHost />
    <div class="flex items-center gap-4 max-md:gap-1">
        @if (Theme.EnableOtp)
        {
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Large" Class="max-md:hidden" OnClick="ShowLogin">
                <SfIcon Name="user" data-icon="inline-start" /><span>@(_signedIn ? "حساب من" : "ورود / عضویت")</span>
            </BbButton>
        }
        else
        {
            <BbButton Href="@AccountUrl" Variant="ButtonVariant.Ghost" Size="ButtonSize.Large" Class="max-md:hidden">
                <SfIcon Name="user" data-icon="inline-start" /><span>@(_signedIn ? "حساب من" : "ورود / عضویت")</span>
            </BbButton>
        }
        <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="sf-header-separator max-md:hidden" />
        @if (Initial.CartEnabled)
        {
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconLarge" Class="relative" AriaLabel="باز کردن سبد خرید" OnClick="OpenCart">
                <SfIcon Name="bag" data-icon="inline-start" /><span class="absolute -top-0.5 -right-0.5 bg-primary text-primary-foreground rounded-full min-w-4 h-4 text-xs px-1">@_count</span>
            </BbButton>
        }
    </div>
    <nav class="mobile-nav" aria-label="منوی موبایل">
        <a href="@Theme.HomeUrl">
            <SfIcon Name="@Theme.HomeIcon" /><span>خانه</span>
        </a>
        <a href="@Theme.CatalogUrl">
            <SfIcon Name="search" /><span>فروشگاه</span>
        </a>
        @if (Initial.CartEnabled)
        {
            <button @onclick="OpenCart">
                <SfIcon Name="bag" /><span>سبد (@_count)</span>
            </button>
        }
        @if (Theme.EnableOtp)
        {
            <button @onclick="ShowLogin">
                <SfIcon Name="user" /><span>حساب من</span>
            </button>
        }
        else
        {
            <a href="@AccountUrl">
                <SfIcon Name="user" /><span>حساب من</span>
            </a>
        }
    </nav>
    @if (error.Length > 0)
    {
        <div class="wrap mt-4">
            <BbAlert Variant="AlertVariant.Danger">@error</BbAlert>
        </div>
    }
    <BbSheet Open="cartOpen" OpenChanged="value => cartOpen = value" Side="SheetSide.Left">
        <BbSheetContent Class="sf-sheet" ShowClose="true">
            <BbSheetHeader>
                <BbSheetTitle>سبد خرید تو (@cart.Count)</BbSheetTitle>
                <BbSheetDescription>@Theme.CartDescription</BbSheetDescription>
            </BbSheetHeader>
            <div class="overflow-y-auto flex-1 min-h-0 my-4">@if(cart.Count==0) {
                <BbEmpty Title="سبدت هنوز خالیه." Description="@Theme.EmptyCartDescription">
                    <BbButton Href="@Theme.CatalogUrl" Variant="ButtonVariant.Outline">یک انتخاب تازه پیدا کن</BbButton>
                </BbEmpty>
                } else
                {
                    @foreach (var line in cart.Lines)
                    {
                        <NativeCartItem Line="line" ShowImage="cart.ShowProductImages" Busy="busy" OnQuantity="UpdateQuantity" />
                    }
                }
            </div>
            @foreach (var warning in cart.Warnings)
            {
                <BbAlert Variant="AlertVariant.Warning" Class="mb-3">@warning</BbAlert>
            }
            @foreach (var item in cart.ItemWarnings)
            {
                <BbAlert Variant="AlertVariant.Warning" Class="mb-3"><strong>@item.ProductName</strong>
                    @foreach (var warning in item.Messages)
                    {
                        <p>@((MarkupString)warning)</p>
                    }
                </BbAlert>
            }
            @if(cart.Count > 0) {
            <div class="flex flex-col gap-5">
                    <BbSeparator />
                <div class="flex justify-between font-bold mb-5"><span>جمع کالاها</span><span>@cart.MiniSubTotal</span></div>
                    @if (cart.DisplayShoppingCartButton)
                    {
                        <BbButton Href="@cart.CartUrl" Size="ButtonSize.Large" Class="w-full">دیدن سبد و ادامهٔ خرید</BbButton>
                    }
                    @if (cart.DisplayCheckoutButton)
                    {
                        <BbButton Href="@cart.CheckoutUrl" Variant="ButtonVariant.Secondary" Size="ButtonSize.Large" Class="w-full mt-3">ادامهٔ خرید</BbButton>
                    }
                </div>
            }
        </BbSheetContent>
    </BbSheet>
    @if (Theme.EnableOtp)
    {
    <BbDialog Open="loginOpen" OpenChanged="value => loginOpen = value">
        <BbDialogContent Class="sf-login" ShowClose="true">
            <BbDialogHeader>
                <BbDialogTitle>@(cart.SignedIn ? "حساب تو" : otpSent ? "کد ورود را بنویس" : $"به {Theme.BrandName} خوش اومدی")
                </BbDialogTitle>
                <BbDialogDescription>@(cart.SignedIn ? "سبد خرید به حساب تو متصل است." : "با شمارهٔ موبایلت، ساده و سریع وارد شو.")</BbDialogDescription>
            </BbDialogHeader>
            @if (cart.SignedIn)
            {
                <p class="text-center text-lg py-6" dir="ltr">@cart.Phone</p>
                <BbButton Href="@Theme.AccountUrl" Size="ButtonSize.Large" Class="w-full mb-3">حساب من</BbButton>
                <BbButton Href="@Initial.CartUrl" Size="ButtonSize.Large" Class="w-full">دیدن سبد خرید</BbButton><a href="@Theme.LogoutUrl"
                                                                                                      class="block text-center text-xs text-muted-foreground mt-5">خروج از حساب</a>
            }
            else
            {
                <form @onsubmit="SubmitLogin" @onsubmit:preventDefault class="mt-5">
                    <BbFieldGroup>
                    <BbField data-disabled="@(otpSent ? "true" : null)">
                    <BbFieldLabel For="sf-phone">شمارهٔ موبایل</BbFieldLabel>
                    <BbInput Id="sf-phone" Class="h-11 text-left" dir="ltr" inputmode="tel"
                             autocomplete="tel" placeholder="09123456789" maxlength="13" @bind-Value="phone"
                             UpdateTiming="UpdateTiming.Immediate" Disabled="@otpSent" />
                    </BbField>
                    @if(otpSent) {
                    <BbField>
                    <BbFieldLabel For="sf-code">کد یک‌بارمصرف</BbFieldLabel>
                    <BbInput Id="sf-code" Class="h-11 text-center tracking-[.5em]" dir="ltr"
                             inputmode="numeric" autocomplete="one-time-code" maxlength="6" @bind-Value="code"
                             UpdateTiming="UpdateTiming.Immediate" />
                    </BbField>
                }
                </BbFieldGroup>
                @if (!string.IsNullOrEmpty(loginMessage))
                {
                    <p role="status" class="text-sm text-destructive leading-6 mt-4">@loginMessage</p>
                }
                @if (!string.IsNullOrEmpty(testCode))
                {
                    <BbAlert Variant="AlertVariant.Info" Class="mt-4">محیط آزمایشی · کد ورود: <strong dir="ltr">@testCode</strong><br />پیامک واقعی
                        ارسال نشده است.</BbAlert>
                    }
                    <BbButton Type="ButtonType.Submit" Size="ButtonSize.Large" Class="w-full mt-5" Loading="busy" Disabled="busy">
                        @(otpSent ? "تأیید و ورود" : "دریافت کد ورود")</BbButton>@if(otpSent) {
                        <button type="button" class="text-xs text-primary mt-4"
                                @onclick="() =>
                                    {
                                        otpSent = false;
                                        code = string.Empty;
                                        testCode = string.Empty;
                                    }">تغییر شمارهٔ
                            موبایل</button>
                        }
                        <p class="text-xs text-muted-foreground mt-5 leading-6">شمارهٔ موبایل فقط برای
                            ورود به حساب استفاده می‌شود.</p>
                        </form>
                    }
                </BbDialogContent>
            </BbDialog>
    }
        </BbDirectionProvider>
