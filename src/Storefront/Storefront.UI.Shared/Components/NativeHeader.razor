@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
<BbDirectionProvider Direction="@(Labels.Rtl ? TextDirection.RightToLeft : TextDirection.LeftToRight)">
    <div class="flex items-center gap-4 max-md:gap-1">
        @if (Theme.EnableOtp)
        {
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Large" Class="max-md:hidden" OnClick="ShowLogin">
                <SfIcon Name="user" data-icon="inline-start" /><span>@Labels.Get(_signedIn ? "Account.MyAccount" : "Account.Login")</span>
            </BbButton>
        }
        else
        {
            <BbButton Href="@AccountUrl" Variant="ButtonVariant.Ghost" Size="ButtonSize.Large" Class="max-md:hidden">
                <SfIcon Name="user" data-icon="inline-start" /><span>@Labels.Get(_signedIn ? "Account.MyAccount" : "Account.Login")</span>
            </BbButton>
        }
        <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="sf-header-separator h-7 w-[.0625rem] bg-border max-md:hidden" />
        @if (Initial.CartEnabled)
        {
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconLarge" Class="relative" AriaLabel="@Labels.Get("ShoppingCart")" OnClick="OpenCart">
                <SfIcon Name="bag" data-icon="inline-start" /><span class="absolute -top-0.5 -end-0.5 bg-primary text-primary-foreground rounded-[9999rem] min-w-4 h-4 text-xs px-1">@_count</span>
            </BbButton>
        }
    </div>
    <nav class="mobile-nav fixed inset-x-0 bottom-0 z-30 flex justify-around border-t-[.0625rem] border-border bg-background/96 px-2 pt-[0.4375rem] pb-2.5 backdrop-blur-[0.625rem] md:hidden [&_a]:flex [&_a]:min-h-11 [&_a]:min-w-[3.75rem] [&_a]:flex-col [&_a]:items-center [&_a]:gap-[0.1875rem] [&_a]:text-xs [&_a]:text-muted-foreground [&_button]:flex [&_button]:min-h-11 [&_button]:min-w-[3.75rem] [&_button]:flex-col [&_button]:items-center [&_button]:gap-[0.1875rem] [&_button]:text-xs [&_button]:text-muted-foreground [.boutique-shell_&]:z-50 [.boutique-shell_&]:bg-card [.boutique-shell_&]:p-3 [.boutique-shell_&]:backdrop-blur-none" aria-label="@Labels.Get("Menu")">
        <a href="@Theme.HomeUrl">
            <SfIcon Name="@Theme.HomeIcon" /><span>@Labels.Get("Homepage")</span>
        </a>
        <a href="@Theme.CatalogUrl">
            <SfIcon Name="search" /><span>@Labels.Get("Homepage.Products")</span>
        </a>
        @if (Initial.CartEnabled)
        {
            <button @onclick="OpenCart">
                <SfIcon Name="bag" /><span>@Labels.Get("ShoppingCart") @Labels.Format("ShoppingCart.HeaderQuantity", _count)</span>
            </button>
        }
        @if (Theme.EnableOtp)
        {
            <button @onclick="ShowLogin">
                <SfIcon Name="user" /><span>@Labels.Get("Account.MyAccount")</span>
            </button>
        }
        else
        {
            <a href="@AccountUrl">
                <SfIcon Name="user" /><span>@Labels.Get("Account.MyAccount")</span>
            </a>
        }
    </nav>
    @if (error.Length > 0)
    {
        <div class="wrap mx-auto max-w-[80rem] px-8 max-md:px-5 [.boutique-shell_&]:w-[calc(100%-2.5rem)] [.boutique-shell_&]:max-w-[73.75rem] [.boutique-shell_&]:px-0 max-md:[.boutique-shell_&]:w-[calc(100%-1.75rem)] mt-4">
            <BbAlert Variant="AlertVariant.Danger">@error</BbAlert>
        </div>
    }
    <BbSheet Open="cartOpen" OpenChanged="value => cartOpen = value" Side="@(Labels.Rtl ? SheetSide.Left : SheetSide.Right)">
        <BbSheetContent Class="sf-sheet flex w-[27.5rem] max-w-screen flex-col bg-card text-foreground font-sans pb-[max(1.5rem,env(safe-area-inset-bottom))]" ShowClose="false" dir="@Labels.Direction">
            <BbSheetClose AsChild="false" class="absolute top-4 end-4" aria-label="@Labels.Get("Common.Close")"><SfIcon Name="x" /></BbSheetClose>
            <BbSheetHeader>
                <BbSheetTitle>@Labels.Get("ShoppingCart") @Labels.Format("ShoppingCart.HeaderQuantity", cart.Count)</BbSheetTitle>
                <BbSheetDescription>@Theme.CartDescription</BbSheetDescription>
            </BbSheetHeader>
            <div class="overflow-y-auto flex-1 min-h-0 my-4">@if(cart.Count==0) {
                <BbEmpty Title="@Labels.Get("ShoppingCart.CartIsEmpty")" Description="@Theme.EmptyCartDescription">
                    <BbButton Href="@Theme.CatalogUrl" Variant="ButtonVariant.Outline">@Labels.Get("ShoppingCart.ContinueShopping")</BbButton>
                </BbEmpty>
                } else
                {
                    @foreach (var line in cart.Lines)
                    {
                        <NativeCartItem Line="line" Labels="cart.Labels" ShowImage="cart.ShowProductImages" Busy="busy" OnQuantity="UpdateQuantity" />
                    }
                }
            </div>
            @foreach (var warning in cart.Warnings)
            {
                <BbAlert Variant="AlertVariant.Warning" Class="mb-3">@warning</BbAlert>
            }
            @foreach (var item in cart.ItemWarnings)
            {
                <BbAlert Variant="AlertVariant.Warning" Class="mb-3"><strong>@item.ProductName</strong>
                    @foreach (var warning in item.Messages)
                    {
                        <p>@((MarkupString)warning)</p>
                    }
                </BbAlert>
            }
            @if(cart.Count > 0) {
            <div class="flex flex-col gap-5">
                    <BbSeparator />
                <div class="flex justify-between font-bold mb-5"><span>@Labels.Get("ShoppingCart.Totals.SubTotal")</span><span>@cart.MiniSubTotal</span></div>
                    @if (cart.DisplayShoppingCartButton)
                    {
                        <BbButton Href="@cart.CartUrl" Size="ButtonSize.Large" Class="w-full">@Labels.Get("ShoppingCart.Mini.ViewCart")</BbButton>
                    }
                    @if (cart.DisplayCheckoutButton)
                    {
                        <BbButton Href="@cart.CheckoutUrl" Variant="ButtonVariant.Secondary" Size="ButtonSize.Large" Class="w-full mt-3">@Labels.Get("Checkout.Button")</BbButton>
                    }
                </div>
            }
        </BbSheetContent>
    </BbSheet>
    @if (Theme.EnableOtp)
    {
    <BbDialog Open="loginOpen" OpenChanged="value => loginOpen = value">
        <BbDialogContent Class="sf-login max-w-[min(28.125rem,calc(100vw-2rem))] bg-card text-foreground font-sans" ShowClose="true">
            <BbDialogHeader>
                <BbDialogTitle>@(cart.SignedIn ? "حساب تو" : otpSent ? "کد ورود را بنویس" : $"به {Theme.BrandName} خوش اومدی")
                </BbDialogTitle>
                <BbDialogDescription>@(cart.SignedIn ? "سبد خرید به حساب تو متصل است." : "با شمارهٔ موبایلت، ساده و سریع وارد شو.")</BbDialogDescription>
            </BbDialogHeader>
            @if (cart.SignedIn)
            {
                <p class="text-center text-lg py-6" dir="ltr">@cart.Phone</p>
                <BbButton Href="@Theme.AccountUrl" Size="ButtonSize.Large" Class="w-full mb-3">@Labels.Get("Account.MyAccount")</BbButton>
                <BbButton Href="@Initial.CartUrl" Size="ButtonSize.Large" Class="w-full">@Labels.Get("ShoppingCart.Mini.ViewCart")</BbButton><a href="@Theme.LogoutUrl"
                                                                                                      class="block text-center text-xs text-muted-foreground mt-5">@Labels.Get("Account.Logout")</a>
            }
            else
            {
                <form @onsubmit="SubmitLogin" @onsubmit:preventDefault class="mt-5">
                    <BbFieldGroup>
                    <BbField data-disabled="@(otpSent ? "true" : null)">
                    <BbFieldLabel For="sf-phone">شمارهٔ موبایل</BbFieldLabel>
                    <BbInput Id="sf-phone" Class="h-11 text-left" dir="ltr" inputmode="tel"
                             autocomplete="tel" placeholder="09123456789" maxlength="13" @bind-Value="phone"
                             UpdateTiming="UpdateTiming.Immediate" Disabled="@otpSent" />
                    </BbField>
                    @if(otpSent) {
                    <BbField>
                    <BbFieldLabel For="sf-code">کد یک‌بارمصرف</BbFieldLabel>
                    <BbInput Id="sf-code" Class="h-11 text-center tracking-[.5em]" dir="ltr"
                             inputmode="numeric" autocomplete="one-time-code" maxlength="6" @bind-Value="code"
                             UpdateTiming="UpdateTiming.Immediate" />
                    </BbField>
                }
                </BbFieldGroup>
                @if (!string.IsNullOrEmpty(loginMessage))
                {
                    <p role="status" class="text-sm text-destructive leading-6 mt-4">@loginMessage</p>
                }
                @if (!string.IsNullOrEmpty(testCode))
                {
                    <BbAlert Variant="AlertVariant.Info" Class="mt-4">محیط آزمایشی · کد ورود: <strong dir="ltr">@testCode</strong><br />پیامک واقعی
                        ارسال نشده است.</BbAlert>
                    }
                    <BbButton Type="ButtonType.Submit" Size="ButtonSize.Large" Class="w-full mt-5" Loading="busy" Disabled="busy">
                        @(otpSent ? "تأیید و ورود" : "دریافت کد ورود")</BbButton>@if(otpSent) {
                        <button type="button" class="text-xs text-primary mt-4"
                                @onclick="() =>
                                    {
                                        otpSent = false;
                                        code = string.Empty;
                                        testCode = string.Empty;
                                    }">تغییر شمارهٔ
                            موبایل</button>
                        }
                        <p class="text-xs text-muted-foreground mt-5 leading-6">شمارهٔ موبایل فقط برای
                            ورود به حساب استفاده می‌شود.</p>
                        </form>
                    }
                </BbDialogContent>
            </BbDialog>
    }
        </BbDirectionProvider>
