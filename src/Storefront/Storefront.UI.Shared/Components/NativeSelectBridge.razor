@inject IJSRuntime JS
@using System.Text.Json
@implements IAsyncDisposable

<BbDirectionProvider Direction="@(_state.Rtl ? TextDirection.RightToLeft : TextDirection.LeftToRight)">
    @if (_state.Multiple)
    {
        <BbMultiSelect TValue="MultiSelectOption" @key="_optionsKey" Values="_multiValues" ValuesChanged="SetValues" Disabled="_state.Disabled"
                       Required="_state.Required" AriaLabel="@_state.Label" AriaDescribedBy="@_state.DescribedBy"
                       Placeholder="@_state.Label" SearchPlaceholder="@(_state.Rtl ? "جست‌وجو…" : "Search…")"
                       EmptyMessage="@(_state.Rtl ? "گزینه‌ای پیدا نشد" : "No options found")" ShowSelectAll="false"
                       ClearLabel="@(_state.Rtl ? "پاک کردن" : "Clear")" CloseLabel="@(_state.Rtl ? "بستن" : "Close")"
                       Class="sf-native-select-control w-full [&_button[role=combobox]]:min-h-11 [&_button[role=combobox]]:max-w-full [&_button[role=combobox]]:font-[inherit] [&_[aria-invalid=true]]:border-destructive" aria-invalid="@(_state.Invalid ? "true" : null)">
            @foreach (var option in _state.Options)
            {
                <BbMultiSelectItem TValue="MultiSelectOption" @key="option.Index" Value="@(new MultiSelectOption(option.Value, option.Text))" Text="@option.Text" Disabled="@option.Disabled" />
            }
        </BbMultiSelect>
    }
    else if (_state.Searchable)
    {
        <BbCombobox TValue="string" @key="_optionsKey" Value="@_state.Value" ValueChanged="SetCountryValue"
                    SelectedItemText="@DisplayText(_state.Value)" Disabled="_state.Disabled" Required="_state.Required"
                    AriaLabel="@_state.Label" AriaDescribedBy="@_state.DescribedBy" Placeholder="@_state.Label"
                    SearchPlaceholder="@(_state.Rtl ? "جست‌وجوی کشور…" : "Search countries…")"
                    EmptyMessage="@(_state.Rtl ? "کشوری پیدا نشد" : "No countries found")" MatchTriggerWidth="true"
                    PopoverWidth="bb:w-[12.5rem]"
                    Class="sf-native-select-control w-full [&_button[role=combobox]]:min-h-11 [&_button[role=combobox]]:max-w-full [&_button[role=combobox]]:border-[.0625rem]! [&_button[role=combobox]]:font-[inherit] [&_[aria-invalid=true]]:border-destructive"
                    aria-invalid="@(_state.Invalid ? "true" : null)">
            @foreach (var group in _state.Options.GroupBy(option => option.GroupIndex))
            {
                <BbComboboxGroup @key="group.Key" Label="@group.First().GroupText">
                    @foreach (var option in group)
                    {
                        <BbComboboxItem TValue="string" @key="option.Index" Value="@option.Value" Text="@option.Text" Disabled="@option.Disabled" />
                    }
                </BbComboboxGroup>
            }
        </BbCombobox>
    }
    else
    {
        <BbSelect TValue="string" @key="_optionsKey" Value="@_state.Value" ValueChanged="SetValue" Disabled="_state.Disabled" Required="_state.Required"
                  AriaLabel="@_state.Label" DisplayTextSelector="DisplayText" Class="sf-native-select-control w-full [&_button[role=combobox]]:min-h-11 [&_button[role=combobox]]:max-w-full [&_button[role=combobox]]:font-[inherit] [&_[aria-invalid=true]]:border-destructive">
            <BbSelectTrigger TValue="string" Class="min-h-11 max-w-full font-[inherit] aria-invalid:border-destructive" id="@(_state.Id + "__bb")" aria-describedby="@_state.DescribedBy"
                             aria-invalid="@(_state.Invalid ? "true" : null)" aria-required="@(_state.Required ? "true" : null)">
                <BbSelectValue Placeholder="@_state.Label" />
            </BbSelectTrigger>
            <BbSelectContent TValue="string">
                @foreach (var group in _state.Options.GroupBy(option => option.GroupIndex))
                {
                    <BbSelectGroup @key="group.Key">
                        @if (!string.IsNullOrEmpty(group.First().GroupText))
                        {
                            <BbSelectLabel>@group.First().GroupText</BbSelectLabel>
                        }
                        @foreach (var option in group)
                        {
                            <BbSelectItem TValue="string" @key="option.Index" Value="@option.Value" Text="@option.Text" Disabled="@option.Disabled" />
                        }
                    </BbSelectGroup>
                }
            </BbSelectContent>
        </BbSelect>
    }
</BbDirectionProvider>

@code {
    [Parameter] public string BridgeKey { get; set; } = "";
    [Parameter] public string StateJson { get; set; } = "{}";
    private NativeSelectState _state = new();
    private string _optionsKey = "";
    private MultiSelectOption[] _multiValues = [];
    private IJSObjectReference? _module;
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    protected override void OnParametersSet()
    {
        _state = JsonSerializer.Deserialize<NativeSelectState>(StateJson, JsonOptions) ?? new();
        // The pinned BB option registry initializes only once. Rebuild it when
        // native AJAX replaces options, including their order/text/disabled state.
        _optionsKey = JsonSerializer.Serialize(_state.Options);
        _multiValues = _state.Options.Where(option => _state.Values.Contains(option.Value))
            .Select(option => new MultiSelectOption(option.Value, option.Text)).ToArray();
    }

    private string DisplayText(string value) => _state.Options.FirstOrDefault(option => option.Value == value)?.Text ?? _state.Label;
    private Task SetValue(string? value) => WriteValues([value ?? ""]);
    // BB Combobox toggles the chosen item to null. A native country select does
    // not clear when its current option is chosen again; keep that contract.
    private Task SetCountryValue(string? value) => WriteValues([value ?? _state.Value]);
    private Task SetValues(IEnumerable<MultiSelectOption>? values) => WriteValues(values?.Select(value => value.Value).ToArray() ?? []);

    private async Task WriteValues(string[] values)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Storefront.UI.Shared/native-select.js");
        await _module.InvokeVoidAsync("writeNativeValues", BridgeKey, values);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null) await _module.DisposeAsync();
    }

    public sealed class NativeSelectState
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string? DescribedBy { get; set; }
        public string Value { get; set; } = "";
        public string[] Values { get; set; } = [];
        public bool Rtl { get; set; }
        public bool Multiple { get; set; }
        public bool Searchable { get; set; }
        public bool Required { get; set; }
        public bool Disabled { get; set; }
        public bool Invalid { get; set; }
        public List<NativeSelectOption> Options { get; set; } = [];
    }

    public sealed class NativeSelectOption
    {
        public int Index { get; set; }
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
        public bool Disabled { get; set; }
        public int GroupIndex { get; set; }
        public string GroupText { get; set; } = "";
    }

    // In pinned BB's compositional mode the registry appears only when opened.
    // The fallback string must therefore be the human label, not the form ID.
    public sealed record MultiSelectOption(string Value, string Text)
    {
        public override string ToString() => Text;
    }
}
