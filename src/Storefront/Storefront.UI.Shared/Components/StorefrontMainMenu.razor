@implements IAsyncDisposable
@inject IJSRuntime JS
<BbDirectionProvider Direction="@(Menu.Rtl ? TextDirection.RightToLeft : TextDirection.LeftToRight)">
    @if (Mobile)
    {
        <BbButton Variant="ButtonVariant.Ghost" Class="icon-btn flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-md" OnClick="OpenMenu" aria-label="@Menu.Labels.Get("Categories")">
            <SfIcon Name="menu" Size="1.25m" />
        </BbButton>
        <BbSheet Open="_open" OpenChanged="value => _open = value" Side="@(Menu.Rtl ? SheetSide.Right : SheetSide.Left)">
            <BbSheetContent Class="sf-sheet flex w-[27.5rem] max-w-screen flex-col bg-card text-foreground font-sans pb-[max(1.5rem,env(safe-area-inset-bottom))]" ShowClose="false" dir="@(Menu.Rtl ? "rtl" : "ltr")">
                <BbSheetClose AsChild="false" class="absolute top-4 end-4" aria-label="@Menu.Labels.Get("Common.Close")"><SfIcon Name="x" /></BbSheetClose>
                <BbSheetHeader>
                    <BbSheetTitle>@Menu.Labels.Get("Categories")</BbSheetTitle>
                    <BbSheetDescription>@Menu.Name</BbSheetDescription>
                </BbSheetHeader>
                <nav aria-label="@Menu.Labels.Get("Categories")" class="min-h-0 flex-1 overflow-y-auto my-4">
                    @foreach (var item in Menu.Items)
                    {
                        <StorefrontMenuBranch Item="item" />
                    }
                    @if (Access != null && Theme != null)
                    {
                        <BbSeparator Class="!my-4 !h-[0.0625rem] !bg-border" />
                        <div class="flex flex-col gap-1">
                            <BbButton Href="@(Access.SignedIn ? Theme.AccountUrl : Theme.LoginUrl)" Variant="ButtonVariant.Ghost" Class="!justify-start !gap-3 !px-3 !min-h-11 !h-auto !py-2">
                                <SfIcon Name="user" data-icon="inline-start" />
                                @Menu.Labels.Get(Access.SignedIn ? "Account.MyAccount" : "Account.Login")
                            </BbButton>
                            @if (!Access.SignedIn && Access.RegistrationEnabled)
                            {
                                <BbButton Href="@Access.RegisterUrl" Variant="ButtonVariant.Ghost" Class="!justify-start !px-3 !min-h-11 !h-auto !py-2 !text-primary">
                                    @Menu.Labels.Get("Account.Register")
                                </BbButton>
                            }
                            @if (Access.WishlistEnabled)
                            {
                                <BbButton Href="@Access.WishlistUrl" Variant="ButtonVariant.Ghost" Class="!justify-start !gap-3 !px-3 !min-h-11 !h-auto !py-2">
                                    <SfIcon Name="heart" data-icon="inline-start" />
                                    <span>@Menu.Labels.Get("Wishlist")</span><span class="ms-auto text-xs tabular-nums text-muted-foreground">@_wishlistQuantity</span>
                                </BbButton>
                            }
                            @if (Access.SignedIn)
                            {
                                <BbButton Href="@Theme.LogoutUrl" Variant="ButtonVariant.Ghost" Class="!justify-start !px-3 !min-h-11 !h-auto !py-2 !text-destructive">
                                    @Menu.Labels.Get("Account.Logout")
                                </BbButton>
                            }
                        </div>
                    }
                </nav>
            </BbSheetContent>
        </BbSheet>
    }
    else
    {
        <BbNavigationMenu Class="sf-native-menu flex max-w-none [&>div]:w-full" EnableKeyboardNavigation="true"
                          aria-label="@Menu.Labels.Get("Categories")">
            <BbNavigationMenuList Class="gap-8 w-full">
                @for (var index = 0; index < Menu.Items.Count; index++)
                {
                    var item = Menu.Items[index];
                    <BbNavigationMenuItem Value="@($"menu-{Menu.Id}-{index}")" Class="@item.CssClass">
                        @if (item.Children.Count > 0)
                        {
                            <BbNavigationMenuTrigger Class="nav-link whitespace-nowrap bg-transparent py-4 text-sm text-muted-foreground hover:text-primary">@item.Title</BbNavigationMenuTrigger>
                            <BbNavigationMenuContent>
                                <div class="min-w-60 max-w-md p-3 max-h-96 overflow-y-auto">
                                    @if (item.Url.Length > 0)
                                    {
                                        <a href="@item.Url" class="block px-3 py-2 text-primary font-bold">@item.Title</a>
                                    }
                                    @foreach (var child in item.Children)
                                    {
                                        <StorefrontMenuBranch Item="child" />
                                    }
                                </div>
                            </BbNavigationMenuContent>
                        }
                        else if (item.Url.Length > 0)
                        {
                            <BbNavigationMenuLink Href="@item.Url" Class="nav-link flex items-center gap-2 whitespace-nowrap py-4 text-sm text-muted-foreground hover:text-primary">
                                @if (item.CssClass.Split(' ').Contains("sf-menu-all"))
                                {
                                    <SfIcon Name="menu" Size="1.0625m" />
                                }
                                @if (item.CssClass.Split(' ').Contains("sf-menu-offer"))
                                {
                                    <SfIcon Name="star" Size="0.9375m" />
                                }
                                @item.Title
                            </BbNavigationMenuLink>
                        }
                        else
                        {
                            <span class="nav-link whitespace-nowrap py-4 text-sm text-muted-foreground">@item.Title</span>
                        }
                    </BbNavigationMenuItem>
                }
            </BbNavigationMenuList>
        </BbNavigationMenu>
    }
</BbDirectionProvider>
@code {
    [Parameter] public StoreMenu Menu { get; set; } = new();
    [Parameter] public StoreNavigation? Access { get; set; }
    [Parameter] public StorefrontThemeProfile? Theme { get; set; }
    [Parameter]
    public bool Mobile
    {
        get; set;
    }
    private bool _open;
    private string _wishlistQuantity = "";
    private IJSObjectReference? _module;

    private async Task OpenMenu()
    {
        _wishlistQuantity = Access?.WishlistQuantity ?? "";
        if (Access?.WishlistEnabled == true)
        {
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Storefront.UI.Shared/storefront.js");
                _wishlistQuantity = await _module.InvokeAsync<string>("getNativeWishlistQuantity", _wishlistQuantity);
            }
            catch (JSException)
            {
                // Opening navigation remains available if the native count cannot be read.
            }
        }
        _open = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
            await _module.DisposeAsync();
    }
}
