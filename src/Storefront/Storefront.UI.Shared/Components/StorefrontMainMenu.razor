<BbDirectionProvider Direction="@(Menu.Rtl ? TextDirection.RightToLeft : TextDirection.LeftToRight)">
    @if (Mobile)
    {
        <BbButton Variant="ButtonVariant.Ghost" Class="icon-btn" OnClick="() => _open = true" aria-label="@Menu.Labels.Get("Categories")">
            <SfIcon Name="menu" Size="20" />
        </BbButton>
        <BbSheet Open="_open" OpenChanged="value => _open = value" Side="@(Menu.Rtl ? SheetSide.Right : SheetSide.Left)">
            <BbSheetContent Class="sf-sheet" ShowClose="false" dir="@(Menu.Rtl ? "rtl" : "ltr")">
                <BbSheetClose AsChild="false" class="absolute top-4 end-4" aria-label="@Menu.Labels.Get("Common.Close")"><SfIcon Name="x" /></BbSheetClose>
                <BbSheetHeader>
                    <BbSheetTitle>@Menu.Labels.Get("Categories")</BbSheetTitle>
                    <BbSheetDescription>@Menu.Name</BbSheetDescription>
                </BbSheetHeader>
                <nav aria-label="@Menu.Labels.Get("Categories")" class="overflow-y-auto my-4">
                    @foreach (var item in Menu.Items)
                    {
                        <StorefrontMenuBranch Item="item" />
                    }
                </nav>
            </BbSheetContent>
        </BbSheet>
    }
    else
    {
        <BbNavigationMenu Class="sf-native-menu flex max-w-none" EnableKeyboardNavigation="true"
                          aria-label="@Menu.Labels.Get("Categories")">
            <BbNavigationMenuList Class="gap-8 w-full">
                @for (var index = 0; index < Menu.Items.Count; index++)
                {
                    var item = Menu.Items[index];
                    <BbNavigationMenuItem Value="@($"menu-{Menu.Id}-{index}")" Class="@item.CssClass">
                        @if (item.Children.Count > 0)
                        {
                            <BbNavigationMenuTrigger Class="nav-link bg-transparent">@item.Title</BbNavigationMenuTrigger>
                            <BbNavigationMenuContent>
                                <div class="min-w-60 max-w-md p-3 max-h-96 overflow-y-auto">
                                    @if (item.Url.Length > 0)
                                    {
                                        <a href="@item.Url" class="block px-3 py-2 text-primary font-bold">@item.Title</a>
                                    }
                                    @foreach (var child in item.Children)
                                    {
                                        <StorefrontMenuBranch Item="child" />
                                    }
                                </div>
                            </BbNavigationMenuContent>
                        }
                        else if (item.Url.Length > 0)
                        {
                            <BbNavigationMenuLink Href="@item.Url" Class="nav-link flex items-center gap-2">
                                @if (item.CssClass.Split(' ').Contains("sf-menu-all"))
                                {
                                    <SfIcon Name="menu" Size="17" />
                                }
                                @if (item.CssClass.Split(' ').Contains("sf-menu-offer"))
                                {
                                    <SfIcon Name="star" Size="15" />
                                }
                                @item.Title
                            </BbNavigationMenuLink>
                        }
                        else
                        {
                            <span class="nav-link">@item.Title</span>
                        }
                    </BbNavigationMenuItem>
                }
            </BbNavigationMenuList>
        </BbNavigationMenu>
    }
</BbDirectionProvider>
@code {
    [Parameter] public StoreMenu Menu { get; set; } = new();
    [Parameter]
    public bool Mobile
    {
        get; set;
    }
    private bool _open;
}
