@if (Item.Url.Length > 0)
{
    <a href="@Item.Url" class="block py-2 px-3 text-sm @Item.CssClass">@Item.Title</a>
}
else
{
    <span class="block py-2 px-3 text-sm @Item.CssClass">@Item.Title</span>
}
@if (Item.Children.Count > 0)
{
    <div class="pr-4 border-r border-slate-100">
        @foreach (var child in Item.Children)
        {
            <StorefrontMenuBranch Item="child" />
        }
    </div>
}

@code {
    [Parameter] public StoreMenuItem Item { get; set; } = new();
}
