@if (Item.Url.Length > 0)
{
    <a href="@Item.Url" class="@(Plain ? "block" : "block py-2 px-3 text-sm") @Item.CssClass">@Item.Title</a>
}
else
{
    <span class="@(Plain ? "block" : "block py-2 px-3 text-sm") @Item.CssClass">@Item.Title</span>
}
@if (Item.Children.Count > 0)
{
    <div class="pr-4 border-r border-slate-100">
        @foreach (var child in Item.Children)
        {
            <StorefrontMenuBranch Item="child" Plain="Plain" />
        }
    </div>
}

@code {
    [Parameter] public StoreMenuItem Item { get; set; } = new();
    [Parameter]
    public bool Plain
    {
        get; set;
    }
}
