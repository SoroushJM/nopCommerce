<div class="bg-[#eaf1fd] text-[#46628b] text-center text-[11px] py-2.5 px-4">یک شروع رنگی برای روزهای تازه <span
    class="mx-2 text-blue-300">✦</span> لوازم‌تحریری که دوستشان داری</div>
    <div class="wrap flex items-center justify-between gap-7 py-5 max-md:py-4">
        <a href="/" class="sf-brand shrink-0" aria-label="مدادرنگ، صفحه اصلی"><span class="brand-mark">
            <SfIcon Size="23" />
        </span><span class="brand-word">مداد<span class="text-primary">رنگ</span><small
        class="block text-[9px] font-normal tracking-normal text-slate-400 mt-0.5">دنیای کوچکِ ایده‌های
        بزرگ</small></span></a>
        <form action="/search" class="search-field max-md:hidden">
            <SfIcon Name="search" Size="19" /><input name="q" aria-label="جست‌وجوی محصولات"
                                                     placeholder="دنبال چی می‌گردی؟ دفتر، مداد، یک ایده تازه..." /><button type="submit"
                                                                                  class="sr-only">جست‌وجو</button>
        </form>
        <div class="flex items-center gap-4 max-md:gap-1">
            <button class="icon-btn text-sm max-md:hidden" @onclick="OnAccount">
                <SfIcon Name="user" /><span>@(SignedIn ? "حساب من" : "ورود / عضویت")</span>
            </button>
            <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="sf-header-separator max-md:hidden" />
            @if (CartEnabled)
            {
                <button class="icon-btn relative" aria-label="باز کردن سبد خرید" @onclick="OnCart">
                    <SfIcon Name="bag" Size="23" /><span
                    class="absolute -top-0.5 -right-0.5 bg-primary text-white rounded-full min-w-4 h-4 text-[10px] px-1">@CartCount</span>
                </button>
            }
        </div>
    </div>

@code {
    [Parameter] public bool SignedIn { get; set; }
    [Parameter] public bool CartEnabled { get; set; } = true;
    [Parameter] public int CartCount { get; set; }
    [Parameter] public EventCallback OnAccount { get; set; }
    [Parameter] public EventCallback OnCart { get; set; }
}
