<nav aria-label="دسته‌بندی‌های فروشگاه" class="wrap border-t border-slate-100">
    <BbNavigationMenu Class="hidden md:flex" EnableKeyboardNavigation="true">
        <BbNavigationMenuList Class="gap-8 flex-wrap">
            @for (var index = 0; index < Menu.Items.Count; index++)
            {
                var item = Menu.Items[index];
                <BbNavigationMenuItem Value="@($"menu-{Menu.Id}-{index}")">
                    @if (item.Children.Count > 0)
                    {
                        <BbNavigationMenuTrigger Class="@($"nav-link bg-transparent {item.CssClass}")">@item.Title
                        </BbNavigationMenuTrigger>
                        <BbNavigationMenuContent>
                            <div class="min-w-60 max-w-md p-3 max-h-96 overflow-y-auto">
                                @if (item.Url.Length > 0)
                                {
                                    <a href="@item.Url" class="block px-3 py-2 text-primary font-bold">@item.Title</a>
                                }
                                @foreach (var child in item.Children)
                                {
                                    <StorefrontMenuBranch Item="child" />
                                }
                            </div>
                        </BbNavigationMenuContent>
                    }
                    else if (item.Url.Length > 0)
                    {
                        <BbNavigationMenuLink Href="@item.Url" Class="@($"nav-link {item.CssClass}")">@item.Title
                        </BbNavigationMenuLink>
                    }
                    else
                    {
                        <span class="nav-link @item.CssClass">@item.Title</span>
                    }
                </BbNavigationMenuItem>
            }
        </BbNavigationMenuList>
    </BbNavigationMenu>
    <div class="md:hidden">
        <BbButton Variant="ButtonVariant.Ghost" Class="text-sm w-full justify-start" OnClick="() => _open = !_open"
                  aria-expanded="@_open">
            <SfIcon Name="menu" Size="17" /><span class="mr-2">دسته‌بندی‌ها</span>
        </BbButton>
        @if (_open)
        {
            <div class="max-h-80 overflow-y-auto pb-3">
                @foreach (var item in Menu.Items)
                {
                    <StorefrontMenuBranch Item="item" />
                }
            </div>
        }
    </div>
</nav>

@code {
    [Parameter] public StoreMenu Menu { get; set; } = new();
    private bool _open;
}
