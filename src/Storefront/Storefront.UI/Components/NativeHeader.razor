@implements IAsyncDisposable
@inject IJSRuntime JS
<BbDirectionProvider Direction="TextDirection.RightToLeft">
    <BbPortalHost />
    <div class="flex items-center gap-4 max-md:gap-1">
        <button class="icon-btn text-sm max-md:hidden" @onclick="ShowLogin">
            <SfIcon Name="user" /><span>@(_signedIn ? "حساب من" : "ورود / عضویت")</span>
        </button>
        <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="sf-header-separator max-md:hidden" />
        @if (Initial.CartEnabled)
        {
            <button class="icon-btn relative" aria-label="باز کردن سبد خرید" @onclick="OpenCart">
                <SfIcon Name="bag" Size="23" /><span class="absolute -top-0.5 -right-0.5 bg-primary text-white rounded-full min-w-4 h-4 text-[10px] px-1">@_count</span>
            </button>
        }
    </div>
    <nav class="mobile-nav" aria-label="منوی موبایل">
        <button onclick="location.href='/'">
            <SfIcon Name="pencil" /><span>خانه</span>
        </button>
        <button onclick="location.href='/stationery/catalog'">
            <SfIcon Name="search" /><span>فروشگاه</span>
        </button>
        @if (Initial.CartEnabled)
        {
            <button @onclick="OpenCart">
                <SfIcon Name="bag" /><span>سبد (@_count)</span>
            </button>
        }
        <button @onclick="ShowLogin">
            <SfIcon Name="user" /><span>حساب من</span>
        </button>
    </nav>
    @if (error.Length > 0)
    {
        <div class="wrap mt-4">
            <BbAlert Class="sf-notice notice">@error</BbAlert>
        </div>
    }
    <BbSheet Open="cartOpen" OpenChanged="value => cartOpen = value" Side="SheetSide.Left">
        <BbSheetContent Class="sf-sheet" ShowClose="true">
            <BbSheetHeader>
                <BbSheetTitle>سبد خرید تو (@cart.Count)</BbSheetTitle>
                <BbSheetDescription>یک جای کوچک برای انتخاب‌های رنگی</BbSheetDescription>
            </BbSheetHeader>
            <div class="overflow-y-auto flex-1 min-h-0 my-4">@if(cart.Count==0) {
                <div class="text-center py-12 text-sm text-slate-500">سبدت هنوز خالیه.<br /><a
                    href="/stationery/catalog" class="text-primary inline-block mt-5">یک انتخاب تازه پیدا کن
                    ←</a></div>
                } else
                {
                    @foreach (var line in cart.Lines)
                    {
                        <CartItem Line="line" OnQuantity="UpdateQuantity" />
                    }
                }
            </div> @if(cart.Count > 0) {
            <div class="border-t pt-5">
                <div class="flex justify-between font-bold mb-5"><span>جمع سبد</span><span>@Money(cart.Total) <small
                    class="text-xs font-normal">تومان</small></span></div>
                    <BbButton Href="/stationery/cart" Class="sf-button w-full">دیدن سبد و ادامهٔ خرید</BbButton>
                </div>
            }
        </BbSheetContent>
    </BbSheet>
    <BbDialog Open="loginOpen" OpenChanged="value => loginOpen = value">
        <BbDialogContent Class="sf-login" ShowClose="true">
            <BbDialogHeader>
                <BbDialogTitle>@(cart.SignedIn ? "حساب تو" : otpSent ? "کد ورود را بنویس" : "به مدادرنگ خوش اومدی")
                </BbDialogTitle>
                <BbDialogDescription>@(cart.SignedIn ? "سبد خرید به حساب تو متصل است." : "با شمارهٔ موبایلت، ساده و سریع وارد شو.")</BbDialogDescription>
            </BbDialogHeader>
            @if (cart.SignedIn)
            {
                <p class="text-center text-lg py-6" dir="ltr">@cart.Phone</p>
                <BbButton Href="/stationery/cart" Class="sf-button w-full">دیدن سبد خرید</BbButton><a href="/logout"
                                                                                                      class="block text-center text-xs text-slate-500 mt-5">خروج از حساب</a>
            }
            else
            {
                <form @onsubmit="SubmitLogin" @onsubmit:preventDefault class="mt-5">
                    <BbLabel For="sf-phone" Class="sf-label text-xs block mb-2">شمارهٔ موبایل</BbLabel>
                    <BbInput Id="sf-phone" Class="sf-input sf-bb-input text-left" dir="ltr" inputmode="tel"
                             autocomplete="tel" placeholder="09123456789" maxlength="13" @bind-Value="phone"
                             UpdateTiming="UpdateTiming.Immediate" Disabled="@otpSent" />@if(otpSent) {
                    <BbLabel For="sf-code" Class="sf-label text-xs block mb-2 mt-5">کد یک‌بارمصرف</BbLabel>
                    <BbInput Id="sf-code" Class="sf-input sf-bb-input text-center tracking-[.5em]" dir="ltr"
                             inputmode="numeric" autocomplete="one-time-code" maxlength="6" @bind-Value="code"
                             UpdateTiming="UpdateTiming.Immediate" />
                }
                @if (!string.IsNullOrEmpty(loginMessage))
                {
                    <p role="status" class="text-xs text-orange-600 leading-6 mt-4">@loginMessage</p>
                }
                @if (!string.IsNullOrEmpty(testCode))
                {
                    <p class="notice mt-4">محیط آزمایشی · کد ورود: <strong dir="ltr">@testCode</strong><br />پیامک واقعی
                        ارسال نشده است.</p>
                    }
                    <BbButton Type="ButtonType.Submit" Class="sf-button w-full mt-5" Loading="busy" Disabled="busy">
                        @(otpSent ? "تأیید و ورود" : "دریافت کد ورود")</BbButton>@if(otpSent) {
                        <button type="button" class="text-xs text-primary mt-4"
                                @onclick="() => { otpSent = false; code = string.Empty; testCode = string.Empty; }">تغییر شمارهٔ
                            موبایل</button>
                        }
                        <p class="text-[10px] text-slate-400 mt-5 leading-6">شمارهٔ موبایل فقط برای
                            ورود به حساب استفاده می‌شود.</p>
                        </form>
                    }
                </BbDialogContent>
            </BbDialog>
        </BbDirectionProvider>
