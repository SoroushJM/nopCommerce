@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<BbDirectionProvider Direction="TextDirection.RightToLeft">
    <div class="storefront" dir="rtl">
        <main id="main-content">
            <section class="wrap py-7">
                <p class="text-xs text-slate-400 mb-7"><a href="/">خانه</a> / @foreach (var link in Initial.Breadcrumb)
                    {
                        <a href="@link.Url">@link.Name</a><span> / </span>
                    }
                    @Initial.Name
                </p>
                @if (_error.Length > 0)
                {
                    <BbAlert Class="sf-notice notice mb-5">@_error</BbAlert>
                }
                <div class="grid md:grid-cols-2 gap-12 max-md:gap-7">
                    <BbCard Class="sf-product-image product-image"><img src="@_image" alt="@Initial.ImageAlt" />
                    </BbCard>
                    <div>
                        <p class="text-xs text-primary mb-3">@Initial.Brand</p>
                        <h1 class="text-3xl max-md:text-2xl font-extrabold leading-relaxed">@Initial.Name</h1>
                        <p class="text-sm text-slate-500 leading-8 mt-4">@((MarkupString)Initial.Description)</p>
                        <div
                            class="flex items-center gap-2 mt-5 text-xs @(Available ? "text-emerald-600" : "text-orange-600")">
                            <span
                            class="size-1.5 rounded-full @(Available ? "bg-emerald-500" : "bg-orange-500")"></span>@StockLabel
                        </div>
                        <BbSeparator Class="sf-product-separator my-6" />
                        @foreach (var attribute in Initial.Attributes.Where(item =>
                        !_disabledAttributes.Contains(item.Id)))
                        {
                            <fieldset class="mb-6">
                                <legend class="text-sm font-bold mb-3">@(attribute.Name): <span
                                    class="font-normal text-slate-500">@(attribute.Options.FirstOrDefault(option =>
                                    option.Id == _selected.GetValueOrDefault(attribute.Id))?.Name)</span></legend>
                                    @if (attribute.ControlType == 1)
                                    {
                                        <BbSelect TValue="int" Value="_selected.GetValueOrDefault(attribute.Id)"
                                                  ValueChanged="value => SelectOption(attribute.Id, value)">
                                            <BbSelectTrigger Class="sf-select">
                                                <BbSelectValue Placeholder="انتخاب کنید" />
                                            </BbSelectTrigger>
                                            <BbSelectContent>
                                                <BbSelectItem Value="0">@(attribute.Required ? "انتخاب کنید" : "بدون انتخاب")
                                                </BbSelectItem>@foreach (var option in attribute.Options) {
                                                <BbSelectItem Value="option.Id">@option.Name</BbSelectItem>
                                            }
                                        </BbSelectContent>
                                    </BbSelect>
                                }
                                else
                                {
                                    <div class="flex gap-4">
                                        @foreach (var option in attribute.Options)
                                        {
                                            <button type="button"
                                                    class="@(attribute.ControlType is 40 or 45 ? "color-choice" : "filter-pill") @(_selected.GetValueOrDefault(attribute.Id) == option.Id ? "selected" : "")"
                                                    style="@(attribute.ControlType == 40 ? "background:" + option.Color : "")"
                                                    aria-label="@($"{attribute.Name} {option.Name}")"
                                                    aria-pressed="@(_selected.GetValueOrDefault(attribute.Id) == option.Id)"
                                                    @onclick="() => SelectOption(attribute.Id, option.Id)">
                                                @if (attribute.ControlType == 45)
                                                {
                                                    <img src="@option.Image" alt="@option.Name" />
                                                }
                                                else if (attribute.ControlType != 40)
                                                {

                                                    @option.Name
                                                }
                                                else if (_selected.GetValueOrDefault(attribute.Id) == option.Id)
                                                {
                                                    <SfIcon Name="check" Size="16" />
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </fieldset>
                        }
                        <div class="flex items-center gap-5 mb-6">
                            <span class="text-sm">تعداد</span>
                            @if (Initial.Quantities.Count > 0)
                            {
                                <BbSelect TValue="int" Value="_quantity" ValueChanged="ChangeQuantity">
                                    <BbSelectTrigger Class="sf-select">
                                        <BbSelectValue />
                                    </BbSelectTrigger>
                                    <BbSelectContent>@foreach (var value in Initial.Quantities) {
                                        <BbSelectItem Value="value">@value</BbSelectItem>
                                    }
                                </BbSelectContent>
                            </BbSelect>
                        }
                            else
                        {
                            <BbButtonGroup Class="sf-quantity qty"><button aria-label="کاهش تعداد"
                                                                           disabled="@(_quantity <= 1 || _updating)"
                                                                           @onclick="() => ChangeQuantity(_quantity - 1)">
                                <SfIcon Name="minus" Size="14" />
                            </button><span>@_quantity</span><button aria-label="افزایش تعداد" disabled="@_updating"
                                                                @onclick="() => ChangeQuantity(_quantity + 1)">
                            <SfIcon Name="plus" Size="14" />
                        </button></BbButtonGroup>
                    }
                </div>
                <BbCard Class="sf-price-card bg-slate-50 border border-slate-100 rounded-2xl p-5">
                    <div class="flex items-end justify-between mb-5"><span class="text-xs text-slate-500">قیمت
                        هر عدد</span>
                        <div class="text-left">@if (!string.IsNullOrWhiteSpace(Initial.OldPrice)) {
                            <del class="text-xs text-slate-400 block mb-1">@Initial.OldPrice</del>
                        }
                        <strong class="text-2xl price">@_price</strong>
                    </div>
                </div>
                <BbButton Class="sf-button w-full" Disabled="@(!Available || _busy || _updating || !_ready)"
                          Loading="_busy" OnClick="AddToCart">
                    <SfIcon Name="bag" Size="18" /><span class="mr-2">@PurchaseLabel</span>
                </BbButton>
            </BbCard>
            <p class="text-[11px] text-slate-400 mt-5 flex gap-2">
                <SfIcon Name="shield" Size="15" />انتخاب‌ها و موجودی هنگام افزودن به سبد دوباره بررسی
                می‌شوند.
            </p>
        </div>
    </div>
</section>
</main>

</div>
</BbDirectionProvider>
