<section class="hero relative grid overflow-hidden rounded-xl bg-secondary md:grid-cols-2 md:rounded-2xl">
    <div class="hero-copy flex flex-col items-start justify-center px-6 py-7 md:px-12 md:py-11">
        <BbBadge Variant="BadgeVariant.Secondary" Class="mb-4">برای نوشتن، ساختن و خیال‌کردن</BbBadge>
        <h1 class="text-[1.9375rem] font-bold leading-[1.6] tracking-[-0.09375rem] md:text-[2.8125rem]">
            ایده‌های بزرگ،<br />از یک <span class="text-primary">مداد رنگی</span><br class="max-md:hidden" /> شروع می‌شن.
        </h1>
        <p class="mt-4 max-w-sm text-sm leading-7 text-muted-foreground">
            از اولین خط دفتر تا آخرین رنگ نقاشی؛<br />همراه‌های دوست‌داشتنیِ درس، کار و خلاقیت اینجان.
        </p>
        <BbButton Href="@CatalogUrl" Size="ButtonSize.Large" Class="mt-6">
            کشف دنیای رنگ‌ها <SfIcon Name="arrow" data-icon="inline-end" />
        </BbButton>
        <div class="mt-6 flex items-center gap-2 text-xs text-muted-foreground">
            <SfIcon Name="check" Size="0.875m" /> انتخاب‌های متنوع <span class="mx-1">·</span> خرید ساده و راحت
        </div>
    </div>
    <div class="relative">
        <img class="hero-image h-55 w-full object-cover object-center md:h-full"
             src="_content/Storefront.UI.Madadrang/images/hero.jpg"
             alt="لوازم نوشتن و طراحی رنگی روی میز" fetchpriority="high" />
        <BbCard Class="hero-note absolute end-3.5 bottom-3.5 max-w-[calc(100%_-_1.75rem)] md:end-6 md:bottom-6 md:max-w-[calc(100%_-_3rem)]">
            <BbCardHeader Class="flex flex-row items-center gap-3">
                <span class="grid size-9 place-items-center rounded-[9999rem] bg-warning-muted text-warning">
                    <SfIcon Name="star" />
                </span>
                <div>
                    <BbCardTitle>کمی رنگ، کلی حال خوب</BbCardTitle>
                    <BbCardDescription>برای میز کار و کیف مدرسه‌ات</BbCardDescription>
                </div>
            </BbCardHeader>
        </BbCard>
    </div>
</section>
@code {
    [Parameter] public string CatalogUrl { get; set; } = "/stationery/catalog";
}
