<footer class="sf-footer bg-surface [border-top-width:0.0625rem] border-solid border-border [padding:2.625rem_0_1.125rem] max-md:pb-20">
    <div class="wrap max-w-320 mx-auto px-8 max-md:px-4.5">
        <div class="grid md:grid-cols-[2fr_1fr_1fr] gap-8">
            <div><a href="@HomeUrl" class="sf-brand mb-4 flex items-center gap-2.5 [font-size:1.5rem] font-bold [letter-spacing:-0.0625rem] max-md:text-xl"><span class="brand-mark bg-primary text-primary-foreground grid place-items-center w-10.5 h-11 rounded-lg -rotate-7 max-md:[width:2.1875rem] max-md:[height:2.1875rem] max-md:rounded-md">
                <SfIcon />
            </span><span>مداد رنگی</span></a>
            <p class="text-xs text-muted-foreground leading-7 max-w-sm">برای ما، لوازم‌تحریر فقط ابزار نیست؛ یک بهانهٔ کوچک
                برای نوشتن، یاد گرفتن و رنگی‌تر دیدن دنیاست.</p>
            </div>
            @foreach (var menu in Menus)
            {
                <div>
                    <h2 class="text-sm font-bold mb-4">@menu.Name</h2>
                    <div class="flex flex-col gap-3 text-xs text-muted-foreground">
                        @foreach (var item in menu.Items)
                        {
                            <StorefrontMenuBranch Item="item" Plain="true" />
                        }
                    </div>
                </div>
            }
        </div>
        <div class="[border-top-width:0.0625rem] mt-8 pt-5 text-xs text-muted-foreground flex justify-between gap-5"><span>مداد رنگی؛ همراه
            ایده‌های کوچک و بزرگ</span><span>ساخته‌شده برای نوشتن و خیال‌کردن</span></div>
        </div>
    </footer>

@code {
    [Parameter] public List<StoreMenu> Menus { get; set; } = [];
    [Parameter] public string HomeUrl { get; set; } = "/";
}
