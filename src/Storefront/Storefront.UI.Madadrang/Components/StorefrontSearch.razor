<BbDirectionProvider Direction="TextDirection.RightToLeft">
    <form action="/search" method="get" class="sf-search max-md:hidden w-full max-w-117.5 [&_[data-slot='input-group']]:min-h-11!">
        <BbInputGroup>
            <BbInputGroupInput Name="q" AriaLabel="جست‌وجوی محصولات"
                               Placeholder="دنبال چی می‌گردی؟ دفتر، مداد، یک ایده تازه..." />
            <BbInputGroupAddon>
                <BbInputGroupButton Type="ButtonType.Submit" AriaLabel="جست‌وجو">
                    <SfIcon Name="search" />
                </BbInputGroupButton>
            </BbInputGroupAddon>
        </BbInputGroup>
    </form>
</BbDirectionProvider>
