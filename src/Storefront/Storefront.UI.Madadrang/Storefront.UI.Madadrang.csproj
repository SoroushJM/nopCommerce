<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <ProjectReference Include="../Storefront.UI.Shared/Storefront.UI.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="package.json;package-lock.json" CopyToPublishDirectory="Never" />
    <TailwindSources Include="**/*.razor;../Storefront.UI.Shared/**/*.razor;../Storefront.UI.Shared/wwwroot/native-select.css;Styles/input.css;package-lock.json;../../Plugins/Nop.Plugin.Misc.PersianStorefront/Views/**/*.cshtml;../../Presentation/Nop.Web/Themes/Madadrang/Views/**/*.cshtml" />
  </ItemGroup>
  <Target Name="RestoreStorefrontNodeModules" BeforeTargets="PrepareForBuild" Inputs="package-lock.json" Outputs="node_modules/.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="BuildStorefrontStyles" BeforeTargets="PrepareForBuild" DependsOnTargets="RestoreStorefrontNodeModules" Inputs="@(TailwindSources)" Outputs="wwwroot/storefront.css">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
