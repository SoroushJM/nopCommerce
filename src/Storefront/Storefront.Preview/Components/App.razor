@page "/"
@page "/stationery/catalog"
@page "/stationery/cart"
@page "/stationery/product/{Id:int}"
@using Microsoft.AspNetCore.Components
@inject PreviewStore Store
@inject IHttpContextAccessor Context
<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>مدادرنگ | دنیای رنگی لوازم‌تحریر</title>
    <meta name="description"
          content="دفتر، مداد و همراه‌های رنگی برای درس، نوشتن و خلاقیت. فروشگاه فارسی لوازم‌تحریر مدادرنگ." />
    <link rel="stylesheet" href="_content/Storefront.UI/storefront.css" />
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/blazorblueprint.css" />
    <HeadOutlet />
</head>

<body>
    <StorefrontRoot Initial="initial" Page="@(page)" ProductId="productId" @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
@code {
    [Parameter] public int Id { get; set; }
    private Bootstrap initial = default!; private string page = "home"; private int productId;
    protected override void OnInitialized()
    {
        var http = Context.HttpContext!; var
   path = http.Request.Path.Value ?? "/"; page = path.Contains("/catalog") ? "catalog" : path.Contains("/product/") ?
"product" : path.Contains("/cart") ? "cart" : "home"; int.TryParse(path.Split('/').Last(), out
   productId); initial = new(SampleCatalog.Products, Store.Snapshot(http), true);
    }
}
