@page "/renderer/auto"
@page "/renderer/server"
@using Microsoft.AspNetCore.Components
@using Storefront.Preview.Components
<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>Storefront renderer preview</title>
    <link rel="stylesheet" href="_content/Storefront.UI.@ThemeName/@ThemeCss" />
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/blazorblueprint.css" />
    <HeadOutlet />
    <ImportMap />
</head>

<body>
    <RendererProbe @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
@code {
    [Inject] private IConfiguration Configuration { get; set; } = default!;
    private string SelectedTheme => Configuration["StorefrontTheme"] ?? typeof(App).Assembly.GetCustomAttributes(typeof(System.Reflection.AssemblyMetadataAttribute), false).Cast<System.Reflection.AssemblyMetadataAttribute>().FirstOrDefault(item => item.Key == "StorefrontTheme")?.Value ?? "Madadrang";
    private string ThemeName => string.Equals(SelectedTheme, "MishaShop", StringComparison.OrdinalIgnoreCase)
        || string.Equals(SelectedTheme, "Boutique", StringComparison.OrdinalIgnoreCase) ? "MishaShop" : "Madadrang";
    private string ThemeCss => ThemeName == "MishaShop" ? "mishashop.css" : "storefront.css";
}
