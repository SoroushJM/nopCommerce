<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="../../Storefront.Build.props" />
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="StorefrontTheme" Value="$(StorefrontBrand)" />
    <ProjectReference Include="../Storefront.UI.Shared/Storefront.UI.Shared.csproj" />
    <ProjectReference Include="../Storefront.UI.Madadrang/Storefront.UI.Madadrang.csproj" Condition="'$(StorefrontBrand)' == 'Madadrang' Or '$(StorefrontBrand)' == 'All'" />
    <ProjectReference Include="../Storefront.UI.MishaShop/Storefront.UI.MishaShop.csproj" Condition="'$(StorefrontBrand)' == 'MishaShop' Or '$(StorefrontBrand)' == 'All'" />
  </ItemGroup>
</Project>
