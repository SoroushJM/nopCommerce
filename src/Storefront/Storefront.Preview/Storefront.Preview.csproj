<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="StorefrontTheme" Value="$(StorefrontTheme)" />
    <ProjectReference Include="../Storefront.UI.Shared/Storefront.UI.Shared.csproj" />
    <ProjectReference Include="../Storefront.UI.Madadrang/Storefront.UI.Madadrang.csproj" Condition="'$(StorefrontTheme)' == 'Madadrang' Or '$(StorefrontTheme)' == 'All'" />
    <ProjectReference Include="../Storefront.UI.Boutique/Storefront.UI.Boutique.csproj" Condition="'$(StorefrontTheme)' == 'Boutique' Or '$(StorefrontTheme)' == 'All'" />
  </ItemGroup>
</Project>
