<BbDirectionProvider Direction="TextDirection.RightToLeft">
    <section class="boutique-hero" aria-label="مجموعهٔ @BrandName">
        <div class="boutique-hero-copy">
            <span class="boutique-eyebrow">@BrandName</span>
            <h1>@Heading</h1>
            <p>@Description</p>
            <BbButton Href="@CatalogUrl" Size="ButtonSize.Large" Class="boutique-hero-cta">مشاهدهٔ محصولات <SfIcon Name="arrow" Size="18" /></BbButton>
        </div>
        <div class="boutique-hero-media">
            @if (!string.IsNullOrWhiteSpace(ImageUrl))
            {
                <img src="@ImageUrl" alt="@ImageAlt" fetchpriority="high" />
            }
            else
            {
                <div class="boutique-photo-slot">
                    <span class="boutique-photo-symbol" aria-hidden="true">✧</span>
                    <p>جای تصویر مجموعهٔ شما</p>
                    @if (ShowSetupHint)
                    {
                        <small>تصویر اصلی فروشگاه را در تنظیمات قالب Boutique انتخاب کنید.</small>
                    }
                </div>
            }
        </div>
    </section>
</BbDirectionProvider>

@code {
    [Parameter] public string BrandName { get; set; } = "";
    [Parameter] public string Heading { get; set; } = "زیبایی در سادگی";
    [Parameter] public string Description { get; set; } = "انتخاب‌هایی برای استایلِ خودت";
    [Parameter] public string ImageUrl { get; set; } = "";
    [Parameter] public string ImageAlt { get; set; } = "";
    [Parameter] public string CatalogUrl { get; set; } = "/search";
    [Parameter] public bool ShowSetupHint { get; set; }
}
